#
# lxdtop-remote: run lxdtop on an LXD host over SSH, from your own Mac or Linux machine.
#   lxdtop-remote [host] [lxdtop options]   show it in this terminal (q quits)
#   lxdtop-remote install <host>            copy lxdtop to <host>:~/bin/lxdtop, check the copy there
#                                           first, and print its version and SHA-256
#   lxdtop-remote install --system <host>   the same, to <host>:/usr/local/bin/lxdtop, one copy for
#                                           every account there, owned by root (needs sudo there)
#   lxdtop-remote screen [host]             flip the host's console between two virtual terminals,
#                                           e.g. a login on tty1 and lxdtop on tty8 (see examples/)
# On the host it runs ~/bin/lxdtop, or the lxdtop on the host's PATH when ~/bin has none
# (a copy installed once for every user, e.g. in /usr/local/bin by install --system).
#
# Settings are optional shell variables in ~/.config/lxdtop/remote.conf:
#   DEFAULT_HOST=myhost       host to use when none is given
#   SCREEN_HOST=myhost        host for `screen` (default: DEFAULT_HOST)
#   SCREEN_VTS="1 8"          the two consoles `screen` flips between (default "1 8")
#   REMOTE_TZ=Europe/Berlin   time zone for lxdtop's clock (default: the host's)
#   WINDOW=160x45             resize this terminal window while lxdtop runs, then put it back
#   LXDTOP=/path/to/lxdtop    the copy `install` sends (default: the lxdtop at this repo's root)
# For a host your SSH config doesn't cover (no alias and no User), it asks for the
# username, offers the last one you gave for that host, and remembers it in
# ~/.config/lxdtop/users.
CONF="$HOME/.config/lxdtop"
# shellcheck source=/dev/null # the user's own settings, if any
[ -f "$CONF/remote.conf" ] && . "$CONF/remote.conf"
USERS="$CONF/users"
SCREEN_VTS=${SCREEN_VTS:-"1 8"}

# Find lxdtop at this repo's root, even when this script is run through a symlink.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
LXDTOP=${LXDTOP:-$(cd "$(dirname "$self")/.." && pwd)/lxdtop}

# Print the user@host to connect to, asking for the username when needed.
login_for() {
  case "$1" in *@*) echo "$1"; return 0 ;; esac
  # If ~/.ssh/config already gives this name a username or turns it into another
  # address, ssh knows how to log in there: use the name as it is.
  user=$(ssh -G -- "$1" 2>/dev/null | awk '$1 == "user" {print $2}')
  default=$(ssh -G lxdtop-unconfigured.invalid 2>/dev/null | awk '$1 == "user" {print $2}')
  real=$(ssh -G -- "$1" 2>/dev/null | awk '$1 == "hostname" {print tolower($2)}')
  given=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  if [ "$user" != "$default" ] || [ "$real" != "$given" ]; then echo "$1"; return 0; fi
  last=$(awk -v h="$1" '$1 == h {u = $2} END {print u}' "$USERS" 2>/dev/null)
  printf 'username on %s%s: ' "$1" "${last:+ [$last]}" >&2
  read -r name
  name=${name:-$last}
  [ -n "$name" ] || { echo "lxdtop-remote: no username given" >&2; return 1; }
  mkdir -p "$CONF"
  { awk -v h="$1" '$1 != h' "$USERS" 2>/dev/null; echo "$1 $name"; } > "$USERS.tmp" && mv "$USERS.tmp" "$USERS"
  echo "$name@$1"
}

# ssh to the host, and give up once it has gone quiet for a minute. A connection that drops
# without a word otherwise leaves ssh waiting until TCP gives up, which can take hours, and the
# view frozen. With these, ssh asks the host's sshd for an answer once 15 seconds pass with
# nothing from it, then every 15 seconds, and gives up when a fourth ask is due with none of the
# three answered: a minute after the host went quiet. A working connection always answers,
# however long the host takes. They are the same for every host, and each call puts the host
# after --, so nothing in its name can be read as an option.
ssh_keepalive() { ssh -o ServerAliveInterval=15 -o ServerAliveCountMax=3 "$@"; }

case "$1" in
  screen)
    host=${2:-${SCREEN_HOST:-$DEFAULT_HOST}}
    [ -n "$host" ] || { echo "usage: lxdtop-remote screen <host> (or set SCREEN_HOST)" >&2; exit 2; }
    dest=$(login_for "$host") || exit 2
    # shellcheck disable=SC2086 # split "1 8" into $1 and $2
    set -- $SCREEN_VTS
    # Needs `sudo chvt` without a password on the host.
    ssh_keepalive -- "$dest" "if [ \"\$(cat /sys/class/tty/tty0/active)\" = tty$2 ]; then sudo -n chvt $1 && echo \"console: tty$1\"; else sudo -n chvt $2 && echo \"console: tty$2\"; fi"
    exit ;;
  install)
    shift
    system=
    if [ "$1" = --system ]; then system=1; shift; fi
    if [ $# -ne 1 ] || [ -z "$1" ]; then echo "usage: lxdtop-remote install [--system] <host>" >&2; exit 2; fi
    [ -f "$LXDTOP" ] || { echo "lxdtop-remote: can't find $LXDTOP" >&2; exit 1; }
    # The SHA-256 of this copy, for the host to check what arrives against:
    # sha256sum on Linux, shasum on macOS.
    if command -v sha256sum >/dev/null; then sum=$(sha256sum < "$LXDTOP"); else sum=$(shasum -a 256 < "$LXDTOP"); fi
    sum=${sum%% *}
    case "$sum" in *[!0123456789abcdef]*) sum= ;; esac
    if [ ${#sum} -ne 64 ]; then
      echo "lxdtop-remote: can't work out the SHA-256 of $LXDTOP (needs sha256sum or shasum)" >&2; exit 1
    fi
    dest=$(login_for "$1") || exit 2
    # One connection, so one login. On the host: write the copy to a new file of its own in
    # ~/bin, made by mktemp, so that two installs at once never share one. Check its SHA-256
    # and that it runs, flush it to disk, and only then rename it over ~/bin/lxdtop with mv,
    # which replaces the file, or a symlink there, in one step. The flush is `sync FILE`,
    # which coreutils and BusyBox both have, so that a power cut just after the rename can't
    # leave an empty file. If a check fails, or the connection drops partway (the copy then
    # ends early, so its SHA-256 is wrong), ~/bin/lxdtop stays as it was and the new file is
    # removed. A connection that drops without a word leaves the copy waiting for more, and
    # sshd may take hours to notice (Ubuntu's TCP keepalive starts after two), so the host
    # gives up once nothing more has arrived for a minute. It doesn't restart anything that
    # runs lxdtop, but it says so when the console service from examples/ is running.
    # With --system, the new file is in the home directory instead, and after its checks,
    # sudo does the rest as root: see $as_root below.
    # shellcheck disable=SC2016 # expanded by the shell on the host, not here
    check='
      new= pid= watch=
      clean() { for p in $pid $watch; do kill "$p" 2>/dev/null; done; [ -z "$new" ] || rm -f "$new"; }
      fail() { clean; printf "lxdtop-remote: %s; %s was not changed\n" "$1" "$target" >&2; exit 1; }
      trap "clean; exit 1" HUP INT TERM
      if [ -z "$system" ]; then
        mkdir -p ~/bin || fail "could not make ~/bin"
        # What an install killed outright left behind: the one name earlier versions used, and
        # new files two days old, which no install is still writing.
        rm -f ~/bin/lxdtop.new
        find ~/bin/. ! -name . -prune -type f -name "lxdtop.new.??????" -mtime +1 -exec rm -f {} \; 2>/dev/null
        new=$(mktemp ~/bin/lxdtop.new.XXXXXX) || fail "could not make a new file in ~/bin"
      else
        command -v sudo >/dev/null || fail "installing in /usr/local/bin needs sudo, and this host has none"
        # The same for --system, whose files wait in the home directory: new files two days old,
        # left by an install killed outright or stopped between its two logins.
        find ~/. ! -name . -prune -type f -name ".lxdtop.new.??????" -mtime +1 -exec rm -f {} \; 2>/dev/null
        new=$(mktemp ~/.lxdtop.new.XXXXXX) || fail "could not make a new file in the home directory"
      fi
      name="~/${new#"$HOME"/}"
      # Receive the copy in the background, so that a watch beside it can stop it. Once a
      # second, until cat ends, the watch looks at how much has arrived, and after a minute
      # with nothing more it stops cat with PIPE, as a broken connection would: no other
      # signal leaves 141, and the shells do not report a job that PIPE stopped.
      exec 3<&0
      cat <&3 >"$new" 3<&- &
      pid=$!
      exec 3<&-
      (
        size=0 still=0
        while sleep 1 && kill -0 "$pid"; do
          now=$(wc -c <"$new")
          if [ "$now" != "$size" ]; then size=$now still=0
          elif [ $((still += 1)) -ge 60 ]; then kill -s PIPE "$pid"; fi
        done
      ) >/dev/null 2>&1 &
      watch=$!
      wait "$pid"; status=$?
      pid= watch=
      [ "$status" -ne 141 ] || fail "nothing more of the copy arrived for a minute"
      [ "$status" -eq 0 ] || fail "could not write $name"
      got=$(sha256sum < "$new") || fail "could not work out the SHA-256 of $name"
      got=${got%% *}
      [ "$got" = "$want" ] || fail "the copy that arrived is incomplete or damaged: its SHA-256 is $got, not $want"
      chmod 755 "$new" || fail "could not make $name executable"
      out=$("$new" --version < /dev/null) || fail "the copy does not run: its --version exited with status $?"
      case $out in "lxdtop "*) ;; *) fail "the copy is not lxdtop: its --version printed \"$out\"" ;; esac
      if [ -z "$system" ]; then
        [ ! -d ~/bin/lxdtop ] || fail "can not replace ~/bin/lxdtop: it is a directory, or a link to one"
        sync "$new" || fail "could not flush $name to disk"
        mv -f "$new" ~/bin/lxdtop || fail "could not rename $name to ~/bin/lxdtop"
        printf "installed %s\nSHA-256 %s, checked on the host\n" "$out" "$got"
        if [ -x /usr/local/bin/lxdtop ] && ! [ ~/bin/lxdtop -ef /usr/local/bin/lxdtop ]; then
          echo "this host also has /usr/local/bin/lxdtop, for every account, and this install did not update it." \
               "To update that one instead, use lxdtop-remote install --system, then remove this one: rm ~/bin/lxdtop"
        fi
      elif ! sudo -n true 2>/dev/null; then
        # sudo wants a password, which needs a terminal, and this connection has the copy instead.
        # The checked file waits for a second login, with one: say which file, by its last six
        # characters, and keep it.
        echo "${new##*.}"; exit 3
      fi'
    # With --system, sudo does the rest: the code in $root, as root, given the checked file and its
    # SHA-256. When it needs no password, the first connection runs this. Otherwise a second login
    # does, with ssh -t, so that sudo can ask on its terminal. Either way the checked file goes,
    # and /usr/local/bin/lxdtop is either as it was or the whole new copy, checked. Then it shows
    # what is installed by running it, and warns when this account's own ~/bin/lxdtop, which
    # nothing updates now, runs in front of it: lxdtop-remote and a PATH with ~/bin first run that.
    # shellcheck disable=SC2016 # expanded by the shell on the host, not here
    as_root='
      trap "rm -f \"\$new\"; exit 1" HUP INT TERM
      sudo $nopw sh -c "$root" lxdtop-remote "$new" "$want"
      status=$?
      rm -f "$new"
      [ "$status" -ne 2 ] || exit 1
      if [ "$status" -ne 0 ]; then
        echo "lxdtop-remote: sudo did not run the install; /usr/local/bin/lxdtop was not changed" >&2; exit 1
      fi
      printf "installed %s\nSHA-256 %s, checked on the host\n" "$(/usr/local/bin/lxdtop --version </dev/null)" "$want"
      if [ -x ~/bin/lxdtop ] && ! [ ~/bin/lxdtop -ef /usr/local/bin/lxdtop ]; then
        echo "this account still has its own ~/bin/lxdtop, which lxdtop-remote runs instead of" \
             "/usr/local/bin/lxdtop, as does a PATH with ~/bin first, and which nothing updates now." \
             "To use /usr/local/bin/lxdtop, remove it: rm ~/bin/lxdtop"
      fi'
    # The part sudo runs as root. It copies the checked file to a new file of its own beside
    # /usr/local/bin/lxdtop, made by mktemp, which only root can change, and checks that file's
    # SHA-256 again: what it renames into place is what was checked, whatever then happens to the
    # first file. As in ~/bin, it flushes it to disk before the rename. It never runs the copy:
    # the user ran its --version before sudo. When it refuses, it says why and exits 2, which sudo
    # never does for its own failures (they are 1), so that the user's side doesn't say it again.
    # shellcheck disable=SC2016 # expanded by the shell on the host, not here
    root='
      src=$1 want=$2 new=
      clean() { [ -z "$new" ] || rm -f "$new"; }
      fail() { clean; printf "lxdtop-remote: %s; /usr/local/bin/lxdtop was not changed\n" "$1" >&2; exit 2; }
      trap "clean; exit 2" HUP INT TERM
      find /usr/local/bin/. ! -name . -prune -type f -name "lxdtop.new.??????" -mtime +1 -exec rm -f {} \; 2>/dev/null
      new=$(mktemp /usr/local/bin/lxdtop.new.XXXXXX) || fail "could not make a new file in /usr/local/bin"
      cat <"$src" >"$new" || fail "could not copy the checked file to $new"
      got=$(sha256sum <"$new") || fail "could not work out the SHA-256 of $new"
      [ "${got%% *}" = "$want" ] || fail "the copy changed after it was checked: its SHA-256 is no longer $want"
      chmod 755 "$new" || fail "could not make $new executable"
      [ ! -d /usr/local/bin/lxdtop ] ||
        fail "can not replace /usr/local/bin/lxdtop: it is a directory, or a link to one"
      sync "$new" || fail "could not flush $new to disk"
      mv -f "$new" /usr/local/bin/lxdtop || fail "could not rename $new to /usr/local/bin/lxdtop"'
    console='
      if systemctl is-active --quiet lxdtop-console 2>/dev/null; then
        echo "lxdtop-console is still running the lxdtop it started with: to run this one, restart it on the host" \
             "with sudo systemctl restart lxdtop-console"
      fi'
    # This end gives up on a quiet connection a minute after the host went quiet, as the host does.
    if [ -z "$system" ]; then
      shown="its ~/bin/lxdtop"
      echo "copying $LXDTOP to $dest:~/bin/lxdtop"
      ssh_keepalive -- "$dest" "want=$sum target='~/bin/lxdtop' system=; $check$console" < "$LXDTOP"
      status=$?
    else
      shown="its /usr/local/bin/lxdtop"
      echo "copying $LXDTOP to $dest:/usr/local/bin/lxdtop"
      # What the host prints comes back once it ends: status 3 means a file waits for a second
      # login, and the last line is the end of its name, which goes into the next command only
      # if it is six letters or digits.
      first="want=$sum target=/usr/local/bin/lxdtop system=1 nopw=-n root='$root'; $check$as_root$console"
      out=$(ssh_keepalive -- "$dest" "$first" < "$LXDTOP")
      status=$?
      if [ $status -ne 3 ]; then
        [ -z "$out" ] || printf '%s\n' "$out"
      else
        kept=$(printf '%s\n' "$out" | tail -n 1)
        case "$kept" in ??????) ;; *) kept=- ;; esac
        case "$kept" in *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789]*)
          echo "lxdtop-remote: $dest did not say which file waits for sudo; /usr/local/bin/lxdtop was not changed" >&2
          exit 1 ;;
        esac
        echo "sudo on $dest wants a password: logging in again, with a terminal for it to ask on"
        ssh_keepalive -t -- "$dest" "want=$sum new=~/.lxdtop.new.$kept nopw= root='$root'; $as_root$console"
        status=$?
      fi
    fi
    # 255: ssh itself failed, and has said why. The host may or may not have got that far.
    if [ $status -eq 255 ]; then
      echo "lxdtop-remote: ssh failed before $dest confirmed the install; $shown is unchanged" \
           "unless the whole copy arrived and passed its checks" >&2
    fi
    exit $status ;;
  ""|-*) host=$DEFAULT_HOST ;;
  *) host=$1; shift ;;
esac
[ -n "$host" ] || { echo "usage: lxdtop-remote <host> [lxdtop options] (or set DEFAULT_HOST)" >&2; exit 2; }
dest=$(login_for "$host") || exit 2
export TERM="${TERM:-xterm-256color}"   # the remote screen needs a terminal type
if [ -n "$WINDOW" ]; then
  size=$(stty size 2>/dev/null)        # this window's rows and columns, to put back afterwards
  printf '\033[8;%s;%st' "${WINDOW#*x}" "${WINDOW%x*}"
  sleep 0.2
fi
# Prefer the user's own ~/bin/lxdtop; otherwise use one on the host's PATH.
# shellcheck disable=SC2016 # expanded by the shell on the host, not here
run='p="$HOME/bin/lxdtop"; [ -x "$p" ] || p=$(command -v lxdtop) || { echo "lxdtop-remote: lxdtop is not in ~/bin or on the PATH of $(hostname)" >&2; exit 127; }; '
# ssh hands the command to the host's shell as one string: quote each lxdtop option for it.
args=
for arg; do args="$args '$(printf '%s' "$arg" | sed "s/'/'\\\\''/g")'"; done
ssh_keepalive -t -- "$dest" "$run${REMOTE_TZ:+TZ=$REMOTE_TZ }\"\$p\"$args"
status=$?
[ -n "$size" ] && printf '\033[8;%s;%st' "${size% *}" "${size#* }"
exit $status
