class Monitor:
    """Reads every counter once per interval and keeps the history for the graphs."""

    def __init__(self, api, events):
        self.api, self.events = api, events
        self.ncpu = os.cpu_count() or 1
        self.procs = ProcessTable()
        self.past = {}                 # recent readings per container, to work out rates
        self.cpu_history = {}          # container -> recent CPU % (for its history column)
        self.stack = collections.deque(maxlen=HISTORY)      # per sample: {container: CPU %}
        self.net_in = collections.deque(maxlen=HISTORY)     # host ports, bytes/s
        self.net_out = collections.deque(maxlen=HISTORY)
        self.rows, self.host, self.nic_rates = [], {}, {}
        self.server, self.pools, self.api_status = {}, [], "off"
        self.zfs, self.zfs_checked = {}, 0.0
        self.nics, self.nics_checked, self.prev_nics = [], 0.0, {}
        self.prev_cpu = None
        self.asked = set()             # new containers we've already asked LXD about
        self.kills = {}                # container -> (its oom_kill count, kills seen since start, when the last was)
        self.series_style = {}         # container -> graph color, kept steady between frames
        self.temp_file = find_cpu_temp_sensor()
        self.freq_files = glob.glob("/sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq")

    def sample(self):
        now = time.monotonic()
        instances = {}
        if self.api:
            instances, self.api_status, self.server, self.pools = self.api.snapshot()
            if self.events:
                self.events.member = self.server.get("member", "")   # so the feed keeps to this cluster member
        uptime = float((read("/proc/uptime") or "0").split()[0])
        self.procs.sample(now)
        if now - self.zfs_checked > 30:          # after the processes: it reads each container's first one
            own = {cg: root_dataset(pid) for cg, pid in self.procs.first.items()}
            self.zfs, self.zfs_checked = find_zfs_datasets(self.server.get("zfs_roots"), own), now
        self.sample_host(uptime)
        self.sample_network(now)
        self.sample_instances(now, instances, uptime)

    def sample_host(self, uptime):
        whole, threads = read_cpu_times()
        cpu, per_thread = None, []
        if self.prev_cpu:
            cpu = busy_pct(whole, self.prev_cpu[0])
            per_thread = [busy_pct(a, b) for a, b in zip(threads, self.prev_cpu[1])]
        self.prev_cpu = (whole, threads)
        mem = read_meminfo()
        # ZFS's cache (the ARC) shows up as "used" memory; split it out.
        arc = int((read_kstat(ZFS_ARCSTATS, ("size",)) or {}).get("size", 0))
        temp = read_int(self.temp_file)
        speeds = [s for s in (read_int(f) for f in self.freq_files) if s]
        try:
            root = os.statvfs("/")
            root_total, root_used = root.f_blocks * root.f_frsize, (root.f_blocks - root.f_bfree) * root.f_frsize
        except OSError:
            root_total = root_used = 0
        self.host = dict(
            cpu=cpu, threads=per_thread,
            temp=temp / 1000 if temp else None,                         # millidegrees
            mhz=sum(speeds) / len(speeds) / 1000 if speeds else None,   # kHz
            mem_total=mem["MemTotal"], mem_free=mem["MemAvailable"], arc=arc,
            mem_used=max(0, mem["MemTotal"] - mem["MemAvailable"] - arc),
            swap_total=mem["SwapTotal"], swap_used=mem["SwapTotal"] - mem["SwapFree"],
            root_total=root_total, root_used=root_used,
            load=(read("/proc/loadavg") or "0 0 0").split()[:3], uptime=uptime, zpools=read_zpool_states())

    def sample_network(self, now):
        if now - self.nics_checked > 60:
            self.nics, self.nics_checked = physical_nics(), now
        rates = {}
        for nic in self.nics:
            rx = read_int(f"/sys/class/net/{nic}/statistics/rx_bytes")
            tx = read_int(f"/sys/class/net/{nic}/statistics/tx_bytes")
            if rx is None or tx is None:
                continue
            before = self.prev_nics.get(nic)
            self.prev_nics[nic] = (now, rx, tx)
            if before:
                secs = now - before[0]
                rates[nic] = (rate(rx, before[1], secs), rate(tx, before[2], secs))
        if rates:
            self.net_in.append(sum(r[0] for r in rates.values()))
            self.net_out.append(sum(r[1] for r in rates.values()))
        self.nic_rates = rates

    def sample_instances(self, now, instances, uptime):
        rows, readings = [], {}
        for path in sorted(glob.glob(CGROUP_GLOB)):
            cg = os.path.basename(path)[len(CGROUP_PREFIX):]
            cpu = read_fields(path + "/cpu.stat", ("usage_usec", "nr_periods", "nr_throttled"))
            cpu_usec = cpu.get("usage_usec")
            if cpu_usec is None:
                continue                          # it stopped between listing and reading
            inst = instances.get(cg, {})
            if self.api and cg not in instances and cg not in self.asked:
                self.asked.add(cg)                # a container LXD hasn't told us about yet:
                self.api.wake.set()               # ask once now rather than wait 15 seconds
            # memory.current includes file cache the kernel can drop at any time.
            # Like `docker stats`, subtract the inactive part of that cache to show
            # what the container is actually holding on to.
            current = read_int(path + "/memory.current") or 0
            inactive = read_fields(path + "/memory.stat", ("inactive_file",)).get("inactive_file", 0)
            started = self.procs.started.get(cg)
            row = new_row(cg, inst, mem=max(0, current - inactive), tasks=read_int(path + "/pids.current"),
                          top=self.procs.top.get(cg),
                          up=uptime - started / CLOCK_TICKS if started is not None else None)
            row.update(read_cgroup_limits(path))
            self.count_kills(cg, read_fields(path + "/memory.events", ("oom_kill",)).get("oom_kill"), now)
            disk, disk_src = self.read_disk(cg, path)
            self.measure(row, now, cpu_usec, disk, disk_src, read_net(inst.get("veths", ())), readings,
                         periods=(cpu.get("nr_periods"), cpu.get("nr_throttled")))
            rows.append(row)

        # VMs have no container cgroup: LXD runs each one as a QEMU process on the
        # host, so read that process instead (CPU time, resident memory, start time).
        for cg, inst in instances.items():
            if inst.get("type") != "virtual-machine" or inst["status"] != "Running" or cg in readings:
                continue
            process = read_vm_process(inst.get("pid"))
            if not process:
                continue
            cpu_usec, rss, start = process
            row = new_row(cg, inst, vm=True, mem=rss, up=uptime - start / CLOCK_TICKS)
            disk, disk_src = self.read_disk(cg)
            self.measure(row, now, cpu_usec, disk, disk_src, read_net(inst.get("veths", ())), readings)
            rows.append(row)

        # Anything else LXD knows about is stopped (or a VM whose process couldn't be read).
        for cg, inst in instances.items():
            if cg not in readings:
                rows.append(new_row(cg, inst, live=False, vm=inst.get("type") == "virtual-machine"))
        for cg in list(self.cpu_history):
            if cg not in readings:
                del self.cpu_history[cg]
        for cg, (_, _, when) in list(self.kills.items()):
            if cg not in readings and (when is None or now - when >= RECENT_KILL):
                del self.kills[cg]            # gone, with no recent kill to remember it by
        self.past, self.rows = readings, rows

        if self.host.get("cpu") is not None:
            sample = {r["cg"]: r["cpu"] for r in rows if r["cpu"]}
            outside = self.host["cpu"] * self.ncpu - sum(sample.values())   # host % -> % of one core
            sample[HOST] = max(0.0, outside)
            self.stack.append(sample)

    def read_disk(self, cg, cgroup_path=None):
        """Bytes read and written so far: from ZFS if the instance's disk is there, else the cgroup."""
        kstat = self.zfs.get(cg)
        if kstat:
            stats = read_kstat(kstat, ("nread", "nwritten"))
            if stats and "nread" in stats:
                return (int(stats["nread"]), int(stats["nwritten"])), "zfs"
            self.zfs_checked = 0                  # dataset was remounted: look it up again
        if cgroup_path:
            return read_io_stat(cgroup_path + "/io.stat"), "io"
        return None, None

    def count_kills(self, cg, total, now):
        """Keep count of the memory kills seen since lxdtop started, and when the latest was seen."""
        if total is None:
            return
        seen, count, when = self.kills.get(cg, (total, 0, None))      # kills before lxdtop started don't count
        added = total - seen if total >= seen else total              # the count starts again on a restart
        if added:
            count, when = count + added, now
        self.kills[cg] = (total, count, when)

    def measure(self, row, now, cpu_usec, disk, disk_src, net, readings, periods=None):
        """Work out rates against this instance's recent readings, then keep this one."""
        cg = row["cg"]
        past = self.past.get(cg) or collections.deque(maxlen=RATE_WINDOW)
        if past:
            last, oldest = past[-1], past[0]
            # CPU time is counted in microseconds; one core flat out = 1,000,000 per second = 100%.
            row["cpu"] = rate(cpu_usec, last["cpu"], now - last["t"]) / 10_000
            # Disk and network come in bursts, so average them over the last few
            # readings rather than show whatever happened in the last interval.
            secs = now - oldest["t"]
            if disk and oldest["disk"] and oldest["disk_src"] == disk_src:
                row["rd"] = rate(disk[0], oldest["disk"][0], secs)
                row["wr"] = rate(disk[1], oldest["disk"][1], secs)
            if net and oldest["net"]:
                row["net_in"] = rate(net[0], oldest["net"][0], secs)
                row["net_out"] = rate(net[1], oldest["net"][1], secs)
            if periods and None not in periods and last.get("periods") and None not in last["periods"]:
                # Of its CPU limit's periods in the last interval, the share in which it was held back.
                ran, held = periods[0] - last["periods"][0], periods[1] - last["periods"][1]
                row["throttled"] = min(100.0, max(0, held) / ran * 100) if ran > 0 else 0.0
        past.append(dict(t=now, cpu=cpu_usec, disk=disk, disk_src=disk_src, net=net, periods=periods))
        readings[cg] = past
        self.cpu_history.setdefault(cg, collections.deque(maxlen=HISTORY)).append(row["cpu"])

    def pick_series(self, samples):
        """The busiest containers over the graph window, each with a steady color."""
        totals = collections.Counter()
        for sample in samples:
            for cg, value in sample.items():
                if cg != HOST:
                    totals[cg] += value
        top = {cg for cg, value in totals.most_common(len(SERIES)) if value > 0}
        for cg in list(self.series_style):
            if cg not in top:
                del self.series_style[cg]
        free = [style for style in SERIES if style not in self.series_style.values()]
        for cg in sorted(top, key=lambda c: -totals[c]):
            if cg not in self.series_style:
                self.series_style[cg] = free.pop(0)
        return sorted(self.series_style, key=lambda c: -totals[c])


# --- Drawing primitives -------------------------------------------------------

class Canvas:
    """Somewhere to draw: styled text at (row, column), clipped at the edges."""

    def __init__(self, height, width):
        self.h, self.w = height, width

    def put(self, y, x, text, style="text", right=None):
        """Write text at (y, x), stopping at column `right`. Returns the column after it."""
        if not text.isprintable():           # names from inside containers can hold escape sequences
            text = "".join(ch if ch.isprintable() else "?" for ch in text)
        if not text.isascii() and not ONE_CELL.issuperset(text):
            # Each character gets one cell, but a wide one (CJK, emoji) takes two on most terminals and a
            # combining one none, which would shift the rest of the line: those become "?" too.
            text = "".join("?" if unicodedata.east_asian_width(ch) in ("W", "F")
                           or unicodedata.category(ch) in ("Mn", "Me") else ch
                           for ch in unicodedata.normalize("NFC", text))
        end = x + len(text)
        right = self.w if right is None else min(right, self.w)
        if 0 <= y < self.h and text and x < right:
            if x < 0:
                text, x = text[-x:], 0
            self._write(y, x, text[:right - x], style)
        return end


class CursesCanvas(Canvas):
    def __init__(self, screen, attrs):
        super().__init__(*screen.getmaxyx())
        self.screen, self.attrs = screen, attrs

    def _write(self, y, x, text, style):
        attr = self.attrs.get(style, 0)
        try:
            if y == self.h - 1 and x + len(text) >= self.w:
                # curses refuses to move the cursor past the bottom-right cell,
                # so write everything before it, then insert that last character.
                self.screen.addstr(y, x, text[:-1], attr)
                self.screen.insstr(y, self.w - 1, text[-1], attr)
            else:
                self.screen.addstr(y, x, text, attr)
        except curses.error:
            pass


class TextCanvas(Canvas):
    """An off-screen canvas, for --dump."""

    def __init__(self, height, width):
        super().__init__(height, width)
        self.cells = [[(" ", None)] * width for _ in range(height)]

    def _write(self, y, x, text, style):
        for i, ch in enumerate(text):
            self.cells[y][x + i] = (ch, style)

    def text(self, color=False):
        lines = []
        for row in self.cells:
            if not color:
                lines.append("".join(ch for ch, _ in row).rstrip())
                continue
            out, current = [], None
            for ch, style in row:
                if style != current:
                    out.append(sgr(style))
                    current = style
                out.append(ch)
            lines.append("".join(out) + "\x1b[0m")
        return "\n".join(lines)


def sgr(style):
    """The escape sequence that sets a style, for --dump --color: 16 colors, as on the console, or
    for the fine drawing the 256-color shades a terminal window gets."""
    color_name, bold = STYLES.get(style, ("white", False))
    code = f"{30 + COLORS.index(color_name)}"
    if FINE and style in STYLES_256:
        number, bold = STYLES_256[style]
        code = f"38;5;{number}"
    return f"\x1b[0;{'7;' if style in REVERSE else ''}{'1;' if bold else ''}{code}m"


class Styled:
    """Draws on another canvas, all of it in one style: how the highlighted row is drawn."""

    def __init__(self, cv, style):
        self.cv, self.style, self.h, self.w = cv, style, cv.h, cv.w

    def put(self, y, x, text, style="text", right=None):
        return self.cv.put(y, x, text, self.style, right)


class Clipped:
    """Draws on another canvas, but no lower than row `last`: how the detail view stays inside its box."""

    def __init__(self, cv, last):
        self.cv, self.last, self.h, self.w = cv, last, cv.h, cv.w

    def put(self, y, x, text, style="text", right=None):
        return self.cv.put(y, x, text, style, right) if y <= self.last else x + len(text)


def put_cells(cv, y, x, cells, right=None):
    """Write a list of (character, style) pairs, joining runs of the same style."""
    run, run_style, run_x = [], None, x
    for i, (ch, style) in enumerate(cells):
        if run and style != run_style:
            cv.put(y, run_x, "".join(run), run_style, right)
            run, run_x = [], x + i
        run_style = style
        run.append(ch)
    if run:
        cv.put(y, run_x, "".join(run), run_style, right)


def put_parts(cv, y, x, parts, right=None):
    """Write a list of (text, style) pieces one after another. Returns the column after them."""
    for text, style in parts:
        x = cv.put(y, x, text, style, right)
    return x


def box(cv, y, x, h, w, style, title=(), right=(), footer=(), footer_right=(), footer_if_room=()):
    """A panel with rounded corners, labels set into its top and bottom edges.

    Labels sit in little tabs the way btop draws them:  ╭─┐cpu┌────┐43°C┌─╮
    Each label is a list of (text, style) pieces. footer_if_room's labels follow the footer's
    left-hand ones, but only where they fit beside the right-hand ones, which they never push out.
    """
    line = G["h"] * (w - 2)
    cv.put(y, x, G["tl"] + line + G["tr"], style)
    for row in range(y + 1, y + h - 1):
        cv.put(row, x, G["v"], style)
        cv.put(row, x + w - 1, G["v"], style)
    cv.put(y + h - 1, x, G["bl"] + line + G["br"], style)
    for row, left_items, right_items, (open_tab, close_tab), if_room in (
            (y, title, right, (G["tab_l"], G["tab_r"]), ()),
            (y + h - 1, footer, footer_right, (G["foot_l"], G["foot_r"]), footer_if_room)):
        pos = x + 2
        for item in left_items:
            pos = cv.put(row, pos, open_tab, style, x + w - 2)
            pos = put_parts(cv, row, pos, item, x + w - 2)
            pos = cv.put(row, pos, close_tab, style, x + w - 2) + 1
        end = x + w - 3                      # last column a right-hand label may use
        for item in reversed(right_items):
            start = end - sum(len(text) for text, _ in item) - 1
            if start <= pos:
                break                        # no room left beside the left-hand labels
            cv.put(row, start, open_tab, style)
            cv.put(row, put_parts(cv, row, start + 1, item), close_tab, style)
            end = start - 2
        for item in if_room:                 # as far from the right-hand labels as they are from the left
            if pos + sum(len(text) for text, _ in item) + 2 > end:
                break
            pos = cv.put(row, pos, open_tab, style)
            pos = put_parts(cv, row, pos, item)
            pos = cv.put(row, pos, close_tab, style) + 1


def tabs_width(labels):
    """The columns a row of labels takes in a box's edge: each one in its two tabs, and one after it.
    box() has room for every right-hand label in an edge when the left-hand and right-hand labels
    together take no more than the box's width less 4."""
    return sum(sum(len(text) for text, _ in label) + 3 for label in labels)


def human(n):
    """Bytes as a short string: 512B, 4.2K, 37M, 2.0G."""
    if n is None:
        return ""
    value, unit = float(n), "B"
    for bigger in "KMGT":
        if value < 1000:
            break
        value, unit = value / 1024, bigger
    if unit == "B":
        return f"{value:.0f}B"
    return f"{value:.1f}{unit}" if value < 10 else f"{value:.0f}{unit}"


def fmt_count(n):
    """A count in about 4 characters: 500, 9999, 42k, 4.2M."""
    return str(n) if n < 10_000 else f"{n / 1000:.0f}k" if n < 1_000_000 else f"{n / 1_000_000:.1f}M"


def fmt_pct(value):
    if value is None:
        return ""
    return f"{value:.1f}%" if value < 99.95 else f"{value:.0f}%"


def fmt_span(secs):
    return f"{secs:.0f}s" if secs < 120 else f"{secs / 60:.0f} min"


def fmt_uptime(secs):
    days, rest = divmod(int(secs), 86400)
    hours, rest = divmod(rest, 3600)
    return f"{days}d {hours}h" if days else f"{hours}h {rest // 60}m" if hours else f"{rest // 60}m"


def fmt_age(secs):
    """A short age for the UP column: 45s, 12m, 3h, 15d."""
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if secs >= size:
            return f"{int(secs // size)}{unit}"
    return f"{int(max(0, secs))}s"


def cpu_style(pct):
    if pct is None:
        return "dim"
    return "text" if pct < 1 else "lo" if pct < 50 else "mid" if pct < 90 else "hi"


def heat(position):
    """Color by place along a bar or up a graph: green, then yellow, then red. The fine drawing has
    ten shades for it (lv0 to lv9), changing at the same places."""
    if FINE:
        return f"lv{min(9, max(0, int(position * 10)))}"
    return "lo" if position < 0.5 else "mid" if position < 0.8 else "hi"


def meter_cells(width, value, scale, color_at):
    if FINE:
        return fine_meter_cells(width, value, scale, color_at)
    lit = min(width, int(value / scale * width + 0.5)) if value and scale else 0
    return [(G["cell"], color_at(i / width)) if i < lit else (G["cell_off"], "faint")
            for i in range(width)]


def fine_meter_cells(width, value, scale, color_at):
    """meter_cells() for the fine drawing: full blocks, then an eighth block for the part of a cell,
    so the meter ends smoothly inside that cell; then a faint light shade for the rest."""
    eighths = min(width * 8, int(value / scale * width * 8 + 0.5)) if value and scale else 0
    full, part = divmod(eighths, 8)
    cells = [(EIGHTHS_LEFT[8], color_at(i / width)) for i in range(full)]
    if part:
        cells.append((EIGHTHS_LEFT[part], color_at(full / width)))
    return cells + [(G["low"], "faint")] * (width - len(cells))


def bar_glyph(fill):
    """column_glyph() for the fine drawing's upright bars: an eighth block, so a bar's top moves
    in eighths of a cell."""
    eighths = min(8, int(fill * 8 + 0.5))
    return EIGHTHS_UP[eighths] if eighths > 0 else None


def column_glyph(fill):
    """How much of one character cell a bar covers: full, medium or light shade, or nothing."""
    if fill >= 0.75:
        return G["full"]
    if fill >= 0.5:
        return G["mid"]
    if fill >= 0.25:
        return G["low"]
    return None


def spark(value):
    """One history cell: the shading shows roughly how busy the container was."""
    if value is None:
        return (" ", "text")
    if value < 0.5:
        return (G["idle"], "faint")
    if value < 2:
        return (G["low"], "lo")
    if value < 10:
        return (G["mid"], "lo")
    return (G["full"], "lo" if value < 50 else "mid" if value < 90 else "hi")


def braille_spark(left, right):
    """spark() for the fine drawing: two samples in one cell, as columns of braille dots: one for a
    little (from 0.5%), two from 2%, three from 10% and four from 50%, colored as spark() colors the
    busier one. A cell of idle samples gets a faint dot at the bottom of each."""
    dots = [0 if v is None or v < 0.5 else 1 if v < 2 else 2 if v < 10 else 3 if v < 50 else 4
            for v in (left, right)]
    if not any(dots):
        if left is None and right is None:
            return (" ", "text")
        return (chr(BRAILLE + (BRAILLE_LEFT[1] if left is not None else 0)
                    + (BRAILLE_RIGHT[1] if right is not None else 0)), "faint")
    busiest = max(v for v in (left, right) if v is not None)
    return (chr(BRAILLE + BRAILLE_LEFT[dots[0]] + BRAILLE_RIGHT[dots[1]]),
            "lo" if busiest < 50 else "mid" if busiest < 90 else "hi")


def history_cells(history, width):
    """A CPU history as cells, newest on the right: one sample a cell, as spark() draws it, or two
    a cell in the fine drawing (braille_spark()). Cells before the oldest sample are blank."""
    if not FINE:
        history = list(history)[-width:]
        return [(" ", "text")] * (width - len(history)) + [spark(v) for v in history]
    history = list(history)[-2 * width:]
    history = [None] * (2 * width - len(history)) + history
    return [braille_spark(history[i], history[i + 1]) for i in range(0, 2 * width, 2)]


def rate_cell(value, width):
    """A disk rate: data, so bytes per second."""
    if value is None:
        return "", "dim"
    if value < 1:
        return "-".rjust(width), "dim"
    return human(value).rjust(width), "text" if value < 10 * MB else "mid" if value < 100 * MB else "hi"


def mbps(bytes_per_sec):
    """A network rate in megabits per second. Bandwidth is counted in bits, data in
    bytes, and network gear uses decimal units: 1 Mb/s = 1,000,000 bits a second."""
    return bytes_per_sec * 8 / 1_000_000


def fmt_mbps(value):
    """Mb/s with the precision that matters: 0, <0.01, 0.42, 10.9, 940, 1240."""
    if value < 0.01:
        return "<0.01" if value > 0 else "0"
    if value < 10:
        return f"{value:.2f}"
    return f"{value:.1f}" if value < 100 else f"{value:.0f}"


def mbps_cell(bytes_per_sec, width):
    """A network rate for the table, in Mb/s."""
    if bytes_per_sec is None:
        return "", "dim"
    value = mbps(bytes_per_sec)
    if value == 0:
        return "-".rjust(width), "dim"
    style = "dim" if value < 0.01 else "text" if value < 100 else "mid" if value < 800 else "hi"
    return fmt_mbps(value).rjust(width), style


# --- Panels -------------------------------------------------------------------

def draw_status(cv, y, mon):
    """Top line: host and versions on the left, the clock centred, counts on the right."""
    x = cv.put(y, 1, socket.gethostname(), "title")
    server = mon.server
    if server.get("version"):
        x = cv.put(y, x + 2, "LXD " + server["version"], "text")
    if cv.w >= 130:
        for part in (server.get("os"), server.get("kernel") and "kernel " + server["kernel"]):
            if part:
                x = put_parts(cv, y, x, [(f"  {G['idle']}  ", "dim"), (part, "dim")])
    running = sum(1 for r in mon.rows if r["live"])
    right = [(f"{running} running", "lo")]
    if len(mon.rows) > running:
        right.append((f" {G['idle']} {len(mon.rows) - running} stopped", "dim"))
    right.append((f"   up {fmt_uptime(mon.host.get('uptime', 0))}", "text"))
    right_x = cv.w - 1 - sum(len(t) for t, _ in right)
    put_parts(cv, y, right_x, right)
    # The clock goes in the middle if it fits between the two sides, else a shorter one, else none.
    for clock in (time.strftime("%a %b %-d  %H:%M:%S %Z"), time.strftime("%H:%M %Z")):
        start = max(x + 2, (cv.w - len(clock)) // 2)
        if start + len(clock) + 2 <= right_x:
            cv.put(y, start, clock, "bright")
            break


def draw_cpu_panel(cv, y, x, h, w, mon):
    host = mon.host
    right = []
    if host.get("temp") is not None:
        temp = host["temp"]
        right.append([(f"{temp:.0f}{G['deg']}C", "lo" if temp < 70 else "mid" if temp < 85 else "hi")])
    if host.get("mhz"):
        right.append([(f"{host['mhz'] / 1000:.1f} GHz", "text")])
    box(cv, y, x, h, w, "b_cpu", title=[[("cpu", "title")]], right=right)
    ix, iw, rows = x + 2, w - 4, h - 2
    pct = host.get("cpu")
    meter_w = iw - 6 - 5
    cv.put(y + 1, ix, "total", "text")
    put_cells(cv, y + 1, ix + 6, meter_cells(meter_w, pct, 100, heat))
    cv.put(y + 1, ix + 6 + meter_w, f"{pct:4.0f}%" if pct is not None else "", cpu_style(pct))

    # One small bar per CPU thread, like a graphic equaliser: colors climb from
    # green to red with height, and partly filled cells use the shade glyphs.
    threads, bar_rows = host.get("threads") or [], rows - 2
    step = 2 if len(threads) * 2 <= iw else 1
    for i, value in enumerate(threads[:iw // step]):
        height = value / 100 * bar_rows
        for level in range(bar_rows):            # level 0 is the bottom row
            glyph = bar_glyph(height - level) if FINE else column_glyph(height - level)
            if glyph:
                style = heat((level + 1) / bar_rows)
            elif level == 0:
                glyph, style = G["idle"], "faint"
            else:
                continue
            cv.put(y + 1 + bar_rows - level, ix + i * step, glyph, style)
    load = put_parts(cv, y + rows, ix, [("load ", "text"), (" ".join(host.get("load", [])), "bright")])
    label = f"{len(threads)} threads" if threads else ""
    cv.put(y + rows, max(load + 2, ix + iw - len(label)), label, "dim")


def draw_mem_panel(cv, y, x, h, w, mon):
    host = mon.host
    total = host.get("mem_total") or 1
    box(cv, y, x, h, w, "b_mem", title=[[("memory", "title")]],
        right=[[(human(host.get("mem_total")), "text"), (" total", "dim")]])
    ix, iw = x + 2, w - 4
    meters = [("used", host["mem_used"], total, "mem"), ("zfs", host["arc"], total, "arc"),
              ("free", host["mem_free"], total, "free")]
    if host.get("swap_total"):
        meters.append(("swap", host["swap_used"], host["swap_total"], "swap"))
    meter_w = iw - 17                            # label 6, value 6, percent 5
    for i, (label, value, scale, style) in enumerate(meters[:h - 3]):
        row = y + 1 + i
        cv.put(row, ix, label, "text")
        # The fine drawing colors used memory and swap by level, like the CPU meter; the ZFS cache
        # and free memory aren't warnings however full they are, so they keep their own colors.
        color_at = heat if FINE and style in ("mem", "swap") else (lambda _, s=style: s)
        put_cells(cv, row, ix + 6, meter_cells(meter_w, value, scale, color_at))
        cv.put(row, ix + 6 + meter_w, human(value).rjust(6), style)
        cv.put(row, ix + 12 + meter_w, f"{value / scale * 100:4.0f}%", "text")
    # Bottom row: storage pools from LXD, then the root filesystem. A ZFS pool that isn't ONLINE
    # shows its state in red: after the LXD pool of the same name, or on its own before root.
    sick = {pool: state for pool, state in host.get("zpools", {}).items() if state != "ONLINE"}
    disks = list(mon.pools) + [(pool, None, None) for pool in sorted(sick) if pool not in {p[0] for p in mon.pools}]
    disks += [("root", host["root_used"], host["root_total"])] if host.get("root_total") else []
    pos = ix
    for name, used, size in disks:
        parts = [(name + " ", "hi" if name in sick else "text")]
        if size is not None:
            share = used / size * 100 if size else 0
            parts += [(human(used), "bright"), ("/" + human(size), "dim"),
                      (f" {share:.0f}%", "mid" if share >= 80 else "dim")]
        if name in sick:
            parts.append(((" " if size is not None else "") + sick[name], "hi"))
        pos = put_parts(cv, y + h - 2, pos, parts + [("   ", "dim")], ix + iw)


def draw_net_panel(cv, y, x, h, w, mon):
    """Host ports, drawn the way btop does it: traffic in grows up, traffic out grows down."""
    ins, outs = list(mon.net_in), list(mon.net_out)
    label_w = 11
    gw = w - 4 - label_w
    window_in, window_out = ins[-gw:], outs[-gw:]
    peak = max(window_in + window_out, default=0)
    box(cv, y, x, h, w, "b_net", title=[[("network", "title")]],
        right=[[("peak ", "dim"), (fmt_mbps(mbps(peak)) + " Mb/s", "text")]])
    ix, rows = x + 2, h - 2
    half = (rows - 1) // 2                       # graph rows each way; the last row lists the ports
    scale = max(peak, 1024.0)
    recent_in = sum(ins[-3:]) / len(ins[-3:]) if ins else None
    recent_out = sum(outs[-3:]) / len(outs[-3:]) if outs else None
    cv.put(y + 1, ix, f"{G['down']} in", "net_in")
    cv.put(y + 2, ix, (fmt_mbps(mbps(recent_in)) + " Mb/s") if recent_in is not None else "", "bright")
    cv.put(y + 1 + half, ix, f"{G['up']} out", "net_out")
    cv.put(y + 2 + half, ix, (fmt_mbps(mbps(recent_out)) + " Mb/s") if recent_out is not None else "", "bright")
    gx = ix + label_w + (gw - len(window_in))
    for col, (v_in, v_out) in enumerate(zip(window_in, window_out)):
        for level in range(half):                # level 0 sits on the middle line
            for value, row, style in ((v_in, y + half - level, "net_in"),
                                      (v_out, y + 1 + half + level, "net_out")):
                glyph = column_glyph(value / scale * half - level)
                if glyph:
                    cv.put(row, gx + col, glyph, style)
                elif level == 0:
                    cv.put(row, gx + col, G["idle"], "faint")
    # One entry per port in Mb/s, busiest first, so a busy trunk never falls off the end.
    pos = cv.put(y + rows, ix, "Mb/s  ", "dim", ix + w - 4)
    for nic, (r_in, r_out) in sorted(mon.nic_rates.items(), key=lambda item: (-sum(item[1]), item[0])):
        pos = put_parts(cv, y + rows, pos, [
            (nic + " ", "dim"), (G["down"], "net_in"), (fmt_mbps(mbps(r_in)) + " ", "text"),
            (G["up"], "net_out"), (fmt_mbps(mbps(r_out)) + "  ", "text")], ix + w - 4)


def draw_graph(cv, y0, x0, width, height, mon):
    """Stacked CPU history: each column is one sample, each color one container."""
    if FINE:
        return draw_fine_graph(cv, y0, x0, width, height, mon)
    label_w = 6
    samples = list(mon.stack)[-(width - label_w):]
    series = mon.pick_series(samples)
    peak = max((sum(s.values()) for s in samples), default=0.0)
    scale = min(next((s for s in GRAPH_SCALES if s >= peak * 1.05), GRAPH_SCALES[-1]), mon.ncpu * 100)
    for row, value in ((0, scale), (height // 2, scale / 2), (height - 1, 0)):
        cv.put(y0 + row, x0, f"{value:g}%".rjust(label_w - 1), "dim")

    styles = [mon.series_style[cg] for cg in series] + ["other", "host"]
    grid = [[(" ", "text")] * len(samples) for _ in range(height)]
    for col, sample in enumerate(samples):
        values = [sample.get(cg, 0.0) for cg in series]
        values.append(sum(v for cg, v in sample.items() if cg != HOST and cg not in series))
        values.append(sample.get(HOST, 0.0))
        tops, total = [], 0.0               # where each layer ends, in rows
        for value in values:
            total += value / scale * height
            tops.append(total)
        for row in range(height):           # row 0 is the bottom
            glyph = column_glyph(total - row)
            if not glyph:
                break
            # A full cell takes the color of the layer at its middle; a partly
            # filled top cell takes the color of the topmost layer.
            probe = row + 0.5 if glyph == G["full"] else total - 1e-9
            style = next(st for top, st in zip(tops, styles) if top > probe)
            grid[height - 1 - row][col] = (glyph, style)
    start = x0 + label_w + (width - label_w - len(samples))
    for row in range(height):
        put_cells(cv, y0 + row, start, grid[row], right=x0 + width)
    return series


def draw_fine_graph(cv, y0, x0, width, height, mon):
    """draw_graph() in braille, for the fine drawing: two samples a cell, side by side, and four
    dots to a cell's height. A cell has one color: its taller column's, picked the way draw_graph()
    picks a cell's (the layer at its middle when full, else its topmost)."""
    label_w, dots = 6, height * 4
    samples = list(mon.stack)[-2 * (width - label_w):]
    series = mon.pick_series(samples)
    peak = max((sum(s.values()) for s in samples), default=0.0)
    scale = min(next((s for s in GRAPH_SCALES if s >= peak * 1.05), GRAPH_SCALES[-1]), mon.ncpu * 100)
    for row, value in ((0, scale), (height // 2, scale / 2), (height - 1, 0)):
        cv.put(y0 + row, x0, f"{value:g}%".rjust(label_w - 1), "dim")

    styles = [mon.series_style[cg] for cg in series] + ["other", "host"]
    columns = [(0, 0.0, [])] * (len(samples) % 2)     # (dots lit, total, layer tops): newest at a cell's right
    for sample in samples:
        values = [sample.get(cg, 0.0) for cg in series]
        host = sample.get(HOST, 0.0)
        values += [max(0.0, sum(sample.values()) - sum(values) - host), host]     # other instances, host itself
        tops, total = [], 0.0                # where each layer ends, in dots
        for value in values:
            total += value / scale * dots
            tops.append(total)
        columns.append((min(dots, int(total + 0.5)), total, tops))
    cells = len(columns) // 2
    grid = [[(" ", "text")] * cells for _ in range(height)]
    for col in range(cells):
        left, right = columns[2 * col], columns[2 * col + 1]
        for row in range(height):            # row 0 is the bottom
            n_left, n_right = (min(4, max(0, lit - 4 * row)) for lit, _, _ in (left, right))
            if not n_left and not n_right:
                break
            n, (_, total, tops) = (n_right, right) if n_right >= n_left else (n_left, left)
            probe = min(4 * row + (2 if n == 4 else n - 0.5), total - 1e-9)
            style = next(st for top, st in zip(tops, styles) if top > probe)
            grid[height - 1 - row][col] = (chr(BRAILLE + BRAILLE_LEFT[n_left] + BRAILLE_RIGHT[n_right]), style)
    start = x0 + label_w + (width - label_w - cells)
    for row in range(height):
        put_cells(cv, y0 + row, start, grid[row], right=x0 + width)
    return series


def instance_noun(mon):
    """ "containers", or "instances" once there are VMs on the host too."""
    return "instances" if any(r["vm"] for r in mon.rows) else "containers"


def draw_graph_panel(cv, y, x, h, w, mon, ui):
    span = fmt_span((w - 4 - 6) * ui.interval * (2 if FINE else 1))      # the fine graph has two samples a cell
    noun = instance_noun(mon)
    box(cv, y, x, h, w, "b_graph", title=[[(f"cpu by {noun[:-1]}", "title")], [(f"last {span}", "dim")]],
        right=[[("100% = one core", "dim")]])
    series = draw_graph(cv, y + 1, x + 2, w - 4, h - 3, mon)
    pos, right = x + 2, x + w - 2
    for cg in series:
        pos = put_parts(cv, y + h - 2, pos, [(G["cell"] + " ", mon.series_style[cg]), (cg + "  ", "text")], right)
    put_parts(cv, y + h - 2, pos, [(G["cell"] + " ", "other"), (f"other {noun}  ", "text"),
                                   (G["cell"] + " ", "host"), ("host itself", "text")], right)


def draw_events_panel(cv, y, x, h, w, mon):
    feed, status = mon.events.snapshot() if mon.events else ([], "off")
    if len(status) > w - 20:                         # too long to fit beside the title: shorten the error's name
        status = status.replace("Error)", ")")
    box(cv, y, x, h, w, "b_events", title=[[("lxd events", "title")]],
        right=[[(status, "lo" if status == "live" else "mid")]])
    ix, right = x + 2, x + w - 2
    if not feed:
        cv.put(y + 1, ix, "waiting for LXD activity " + G["more"], "dim", right)
        cv.put(y + 2, ix, "starts, stops, snapshots, exec and file", "dim", right)
        cv.put(y + 3, ix, "transfers show up here as they happen", "dim", right)
        return
    now = time.time()
    for i, event in enumerate(feed[:h - 2]):
        label, style = EVENT_LABELS.get(event["action"], (event["action"].replace("instance-", ""), "text"))
        age = now - event["t"]
        clock_style = "bright" if age < 300 else "text" if age < 3600 else "dim"
        pos = put_parts(cv, y + 1 + i, ix, [
            (time.strftime("%H:%M:%S", time.localtime(event["t"])), clock_style),
            ("  " + label[:9].ljust(10), style), (event["name"][:14].ljust(15), "bright")], right)
        count = f"{G['times']}{event['count']}" if event["count"] > 1 else ""
        tail = " ".join(part for part in (event["detail"], event["user"]) if part)
        cv.put(y + 1 + i, pos, tail, "dim", right - len(count) - 1 if count else right)
        if count:
            cv.put(y + 1 + i, right - len(count), count, "key")


# The extra columns on screens wider than OPS_FROM, added in this order while they fit:
# THROTTLED (share of the CPU limit's periods held back @ the limit in cores), MEM/LIMIT (MEM as
# a share of memory.max), WAITING (its worst stall: cpu, mem or io), MEM KILLS (memory kills since
# lxdtop started, and how long ago the last was), PROCS/LIMIT (TASKS as a share of pids.max) and
# LAST SNAP (how old its newest snapshot is). (column, width)
OPS_COLUMNS = (("thr", 10), ("mem_pct", 12), ("wait", 8), ("kills", 10), ("tasks_pct", 11), ("snap", 9))


def table_layout(width):
    """Pick the columns that fit; the CPU history column gets the width left over.

    Returns {column: (x offset, width)}. Narrow screens drop columns in the
    order listed in `optional`.
    """
    optional = ["ip", "tasks", "net", "up", "top", "disk"]
    for n_drop in range(len(optional) + 1):
        drop = set(optional[:n_drop])
        cols = [("dot", 1, 0), ("name", 14, 1)]                  # (column, width, gap before)
        if "up" not in drop:
            cols.append(("up", 4, 1))
        cols += [("cpu", 6, 1), ("hist", 0, 2)]
        if "top" not in drop:
            cols.append(("top", 18, 2))
        cols.append(("mem", 6, 2))
        if "disk" not in drop:
            cols += [("rd", 7, 2), ("wr", 7, 1)]
        if "net" not in drop:
            cols += [("net_in", 9, 2), ("net_out", 9, 1)]
        if "tasks" not in drop:
            cols.append(("tasks", 5, 2))
        if "ip" not in drop:
            cols.append(("ip", 15, 2))
        room = width - (OPS_FROM - 4)                  # what a screen wider than OPS_FROM adds (table: 4 narrower)
        for name, w in OPS_COLUMNS if n_drop == 0 else ():
            if w + 2 > room:
                break                                  # in order: a later one never jumps ahead
            cols.append((name, w, 2))
            room -= w + 2
        spare = width - sum(w + gap for _, w, gap in cols)
        if spare >= 16 or n_drop == len(optional):
            layout, x = {}, 0
            for name, w, gap in cols:
                x += gap
                if name == "hist":
                    w = max(0, min(spare, 120))
                layout[name] = (x, w)
                x += w
            return layout


HEADERS = (("name", "NAME", "<"), ("up", "UP", ">"), ("cpu", "CPU", ">"), ("top", "BUSIEST PROCESS", "<"),
           ("mem", "MEM", ">"), ("rd", "DISK R", ">"), ("wr", "DISK W", ">"), ("net_in", "IN Mb/s", ">"),
           ("net_out", "OUT Mb/s", ">"), ("tasks", "TASKS", ">"), ("ip", "IPV4", "<"),
           ("thr", "THROTTLED", ">"), ("mem_pct", "MEM/LIMIT", ">"), ("wait", "WAITING", ">"),
           ("kills", "MEM KILLS", ">"), ("tasks_pct", "PROCS/LIMIT", ">"), ("snap", "LAST SNAP", ">"))


def draw_header(cv, y, x0, layout, ui):
    for col, label, align in HEADERS:
        if col in layout:
            x, w = layout[col]
            sorted_here = col in SORT_COLUMNS[ui.sort]
            if sorted_here:
                label += G["sorted"]
            text = label.rjust(w) if align == ">" else label.ljust(w)
            cv.put(y, x0 + x, text[:w], "key" if sorted_here else "bright")
    x, w = layout["hist"]
    label = f"CPU HISTORY (last {fmt_span(w * ui.interval * (2 if FINE else 1))})"
    cv.put(y, x0 + x, (label if len(label) <= w else "CPU HISTORY")[:w], "bright")


def ops_cells(row, mon):
    """The extra columns' (text, style) for one row: {column: (text, style)}. "-" means no limit
    (or no kill), and a cell left out means no reading: VMs and stopped instances have no cgroup here."""
    cells, seen = {}, mon.kills.get(row["cg"])
    if seen and seen[1]:
        ago = time.monotonic() - seen[2]
        cells["kills"] = (f"{seen[1]} {fmt_age(ago)} ago", "hi" if ago < RECENT_KILL else "text")
    elif seen:
        cells["kills"] = ("-", "dim")
    taken = row["snapshot"]
    cells["snap"] = (fmt_age(time.time() - taken), "text") if taken else ("never", "dim")
    if not row["live"] or row["vm"]:
        return cells
    held, cap = row["throttled"], row["cpu_max"]
    if cap is None:
        cells["thr"] = ("-", "dim")
    elif held is not None:
        cells["thr"] = (f"{held:.0f}% @{cap:.3g}c", "mid" if held >= THROTTLED_PCT else "text" if held >= 1 else "dim")
    for col, used, limit, show in (("mem_pct", row["mem"], row["mem_max"], human),
                                   ("tasks_pct", row["tasks"], row["tasks_max"], fmt_count)):
        if limit is None:
            cells[col] = ("-", "dim")
        elif used is not None:
            share = used / limit * 100 if limit else 100.0
            cells[col] = (f"{share:.0f}% of {show(limit)}", "mid" if share >= NEAR_LIMIT_PCT else "text")
    if row["waiting"]:
        resource, share = row["waiting"]
        cells["wait"] = ("-", "dim") if share < 1 else (f"{resource} {share:.0f}%",
                                                       "hi" if share >= PRESSURE_PCT else "text")
    return cells


def draw_row(cv, y, x0, layout, row, mon, marked=()):
    def at(col):
        return x0 + layout[col][0]

    def width(col):
        return layout[col][1]

    name = row["name"]
    if len(name) > width("name"):
        name = name[:width("name") - 1] + G["more"]
    marker = G["vm"] if row["vm"] else G["dot"]
    if "thr" in layout:                                 # the extra columns, on screens wider than OPS_FROM
        for col, (text, style) in ops_cells(row, mon).items():
            if col in layout:
                cv.put(y, at(col), text.rjust(width(col))[:width(col)], style)
    if not row["live"]:
        cv.put(y, at("dot"), marker, "hi" if row["cg"] in marked else "dim")      # red: see the warning
        cv.put(y, at("name"), name, "dim")
        cv.put(y, at("up") if "up" in layout else at("cpu"), row["state"].lower(), "dim")
        return
    cv.put(y, at("dot"), marker, "hi" if row["cg"] in marked else "mid" if row["state"] == "Frozen" else "lo")
    cv.put(y, at("name"), name, mon.series_style.get(row["cg"], "bright"))
    if "up" in layout and row["up"] is not None:
        # Recently (re)started containers stand out in yellow for their first hour.
        up = row["up"]
        cv.put(y, at("up"), fmt_age(up).rjust(width("up")), "mid" if up < 3600 else "text" if up < 86400 else "dim")
    cv.put(y, at("cpu"), fmt_pct(row["cpu"]).rjust(width("cpu")), cpu_style(row["cpu"]))
    if width("hist"):
        put_cells(cv, y, at("hist"), history_cells(mon.cpu_history.get(row["cg"], ()), width("hist")))
    if "top" in layout and row["vm"]:
        cv.put(y, at("top"), "virtual machine", "dim")       # its processes are inside the guest
    elif "top" in layout and row["top"]:
        process, pct = row["top"]
        busy = pct >= 0.05
        cv.put(y, at("top"), process[:12], "text" if busy else "dim")
        if busy:
            cv.put(y, at("top") + 12, fmt_pct(pct).rjust(width("top") - 12), cpu_style(pct))
    cv.put(y, at("mem"), human(row["mem"]).rjust(width("mem")))
    for col, cell in (("rd", rate_cell), ("wr", rate_cell), ("net_in", mbps_cell), ("net_out", mbps_cell)):
        if col in layout:
            text, style = cell(row[col], width(col))
            cv.put(y, at(col), text, style)
    if "tasks" in layout and row["tasks"] is not None:
        cv.put(y, at("tasks"), str(row["tasks"]).rjust(width("tasks")))
    if "ip" in layout:
        cv.put(y, at("ip"), row["ip"], "ip")


def sort_rows(mon, mode):
    def recent_cpu(row):              # average of the last few samples, so rows don't jump about
        values = [v for v in list(mon.cpu_history.get(row["cg"], ()))[-5:] if v is not None]
        return sum(values) / len(values) if values else 0.0

    keys = {
        "cpu": lambda r: -recent_cpu(r),
        "mem": lambda r: -(r["mem"] or 0),
        "disk": lambda r: -((r["rd"] or 0) + (r["wr"] or 0)),
        "net": lambda r: -((r["net_in"] or 0) + (r["net_out"] or 0)),
        "name": lambda r: 0,
    }
    live = sorted((r for r in mon.rows if r["live"]), key=lambda r: (keys[mode](r), r["name"].lower()))
    rest = sorted((r for r in mon.rows if not r["live"]), key=lambda r: r["name"].lower())
    return live + rest


def warnings(mon):
    """What's wrong right now, most serious first: [(how serious, order, text, container or None)].

    A ZFS pool that is down, then a recent memory kill, then a DEGRADED pool, then high pressure,
    then throttling, by the thresholds at the top of the file; within each, the worst first.
    """
    found, now = [], time.monotonic()
    names = {row["cg"]: row["name"] for row in mon.rows}
    for pool, state in sorted(mon.host.get("zpools", {}).items()):
        if state != "ONLINE":
            found.append((3 if state == "DEGRADED" else 5, 0, f"{pool} {state}", None))
    for cg, (_, count, when) in mon.kills.items():
        if count and now - when < RECENT_KILL:
            ago = fmt_age(now - when)
            what = f"memory kill {ago} ago" if count == 1 else f"{count} memory kills, last {ago} ago"
            found.append((4, now - when, f"{names.get(cg, cg)}: {what}", cg))
    for row in mon.rows:
        if row["waiting"] and row["waiting"][1] >= PRESSURE_PCT:
            resource, share = row["waiting"]
            found.append((2, -share, f"{row['name']}: waiting on {resource} {share:.0f}%", row["cg"]))
        if row["cpu_max"] and row["throttled"] is not None and row["throttled"] >= THROTTLED_PCT:
            what = f"throttled {row['throttled']:.0f}% @{row['cpu_max']:.3g}c"
            found.append((1, -row["throttled"], f"{row['name']}: {what}", row["cg"]))
    return sorted(found, key=lambda item: (-item[0], item[1]))


def warning_parts(alerts, room):
    """The warnings as (text, style) pieces for one line of at most `room` characters: as many
    as fit, then how many more there are. Pools and memory kills in red, the rest in yellow."""
    texts, sep = [(text, "hi" if serious >= 3 else "mid") for serious, _, text, _ in alerts], f" {G['idle']} "
    shown, used = 0, -len(sep)                          # (no separator before the first)
    for text, _ in texts:
        rest = len(texts) - shown - 1                   # how many would be left over if this one shows
        if used + len(sep) + len(text) + (len(sep) + len(f"+{rest} more") if rest else 0) > room:
            break
        shown, used = shown + 1, used + len(sep) + len(text)
    if shown:
        more = [(f"+{len(texts) - shown} more", "dim")] if shown < len(texts) else []
    else:                                               # not even one fits: cut the most serious short
        texts, more, shown = [(texts[0][0][:room - 1] + G["more"], texts[0][1])], [], 1
    parts = []
    for text, style in texts[:shown] + more:
        parts += ([(sep, "dim")] if parts else []) + [(text, style)]
    return parts


def draw_table_panel(cv, y, x, h, w, rows, mon, ui, shown=None, fold=False):
    sources_ok = mon.api_status == "ok"
    noun, alerts = instance_noun(mon), warnings(mon)
    title = [[(noun, "title")]]
    edge = w - len(noun) - len("sorted by " + ui.sort) - 13   # the top edge between the title and the sort
    if ui.filter:                                      # a filter is on: say so, and how many it leaves
        matched = [row for row in rows if name_matches(row, ui.filter)]
        title.append([("filter ", "dim"), (ui.filter, "key"), (f"  {len(matched)} of {len(rows)}", "text")])
        edge -= sum(len(text) for text, _ in title[-1]) + 3
        rows = matched
    if alerts and edge >= 8:
        title.append(warning_parts(alerts, edge))
    footer = [[("q", "key"), (" quit", "text")], [("s", "key"), (" sort", "text")],
              [("- +", "key"), (f" every {ui.interval:g}s", "text")]]
    help_tab = [[("?", "key"), (" keys", "text")]]       # where the help screen is: gives way to the status
    if ui.view == "typing":                            # the filter being typed, along the bottom
        footer = [[("/ ", "key"), (ui.filter, "bright"), ("_", "key")],
                  [("Enter", "key"), (" keep", "text")], [("Esc", "key"), (" clear", "text")]]
        help_tab = []                                  # (? is typed into the filter)

    def api(status):
        return [("lxd api ", "dim"), (status, "lo" if sources_ok else "mid")]

    status = mon.api_status
    sources = [api(status), [("disk ", "dim"), ("zfs" if mon.zfs else "io.stat", "dim")]]
    if not sources_ok:
        # A failing API matters more than where the disk numbers come from. Where both don't fit beside
        # the keys (most errors, at 80 columns), the disk label gives way; on a narrower screen the
        # error's name is shortened as the events panel shortens it, then left out.
        tries = [sources, [api(status)], [api(status.replace("Error)", ")"))], [api(status.split(" (")[0])]]
        sources = next((labels for labels in tries if tabs_width(footer) + tabs_width(labels) <= w - 4), tries[-1])
    box(cv, y, x, h, w, "b_table", title=title,
        right=[[("sorted by ", "dim"), (ui.sort, "key")]],
        footer=footer, footer_right=sources, footer_if_room=help_tab)
    ix, iw = x + 2, w - 4
    layout = table_layout(iw)
    draw_header(cv, y + 1, ix, layout, ui)
    marked = {cg for *_, cg in alerts if cg}           # rows to mark in red
    room = h - 3
    if ui.filter and not rows:
        cv.put(y + 2, ix, f'no instance name contains "{ui.filter}"   (Esc clears the filter)', "dim", ix + iw)
        return
    if ui.selected in {row["cg"] for row in rows}:     # a highlighted row: see draw_scrolled()
        draw_scrolled(cv, y + 2, ix, iw, room, layout, rows, mon, ui, marked)
        return
    live = [row for row in rows if row["live"]]
    if shown is None or (shown >= len(live) and not fold):     # a row for every instance, as always
        for i, row in enumerate(rows[:room]):
            if i == room - 1 and len(rows) > room:
                cv.put(y + 2 + i, ix, f"{G['more']} {len(rows) - i} more", "dim")
                break
            draw_row(cv, y + 2 + i, ix, layout, row, mon, marked)
        return
    # A short screen (see fit_layout()): the top running instances in the sort order, "+N more"
    # for the rest of them, then the stopped instances on one line.
    line, bottom = y + 2, y + h - 1
    for row in live[:shown]:
        draw_row(cv, line, ix, layout, row, mon, marked)
        line += 1
    if shown < len(live) and line < bottom:
        cv.put(line, ix, f"+{len(live) - shown} more", "dim")
        line += 1
    gone = rows[len(live):]                           # the stopped ones, by name
    if fold and gone and line < bottom:
        parts = [(f"{len(gone)} stopped: ", "dim")]
        for i, row in enumerate(gone):              # a stopped one with a warning keeps its red
            parts.append(((", " if i else "") + row["name"], "hi" if row["cg"] in marked else "dim"))
        if put_parts(cv, line, ix, parts, ix + iw) > ix + iw:
            cv.put(line, ix + iw - 1, G["more"], "dim")   # cut to fit: say so


def draw_scrolled(cv, y, ix, iw, room, layout, rows, mon, ui, marked):
    """With a row highlighted: a row for every listed instance, scrolled just enough to keep the
    highlighted one in view, with ▲ and ▼ in the right edge when rows are out of view above or below."""
    at = [row["cg"] for row in rows].index(ui.selected)
    if at < ui.scroll:
        ui.scroll = at
    elif at >= ui.scroll + room:
        ui.scroll = at - room + 1
    ui.scroll = max(0, min(ui.scroll, len(rows) - room))
    for i, row in enumerate(rows[ui.scroll:ui.scroll + room]):
        if row["cg"] == ui.selected:                   # in reverse video, across the whole width
            cv.put(y + i, ix - 1, " " * (iw + 2), "sel")
            draw_row(Styled(cv, "sel"), y + i, ix, layout, row, mon, marked)
        else:
            draw_row(cv, y + i, ix, layout, row, mon, marked)
    if ui.scroll > 0:
        cv.put(y, ix + iw + 1, G["up"], "key")
    if ui.scroll + room < len(rows):
        cv.put(y + room - 1, ix + iw + 1, G["down"], "key")


def fit_layout(width, height, running, stopped):
    """Share the screen's rows: (host panels, graph panel, running instances shown, fold the stopped).

    When everything fits, this is the layout lxdtop always had. When the screen is short, space
    gives way in this order: the CPU-by-instance graph shrinks to its smallest; then the stopped
    instances fold into one line; then only the top running instances keep a row, with "+N more"
    for the rest, down to MIN_RUNNING of them; then the graph goes; and the cpu, memory and
    network panels go last.
    """
    host = HOST_ROWS if width >= 120 else 0
    spare = height - 1 - (running + stopped + 3)        # rows left after the status line and the whole table
    if spare - host >= GRAPH_ROWS[0] + (1 if host else 0):     # everything fits: the host panels came
        return host, min(GRAPH_ROWS[1], spare - host), running, False   # with a graph of 8 or more
    folded = 1 if stopped else 0                        # the line the stopped instances fold into
    for host, graph in ((host, GRAPH_ROWS[0]), (host, 0), (0, 0)):
        lines = height - 1 - host - graph - 3          # the table's rows, inside its edges, under its header
        for used, fold in ((running + stopped, False), (running + folded, stopped > 0)):
            if lines >= used:                           # every running instance fits
                extra = min(GRAPH_ROWS[1] - graph, lines - used) if graph else 0   # the rest to the graph
                return host, graph + extra, running, fold
        if lines >= MIN_RUNNING + 1 + folded or not (host or graph):
            return host, graph, max(0, lines - 1 - folded), stopped > 0          # the top ones, "+N more"


def draw(cv, mon, ui):
    """Lay the panels out to fit the screen: fit_layout() says how tall each one is. The help screen
    goes over whichever view it was opened from, and the detail view takes the screen below the
    status line."""
    if cv.w < 70 or cv.h < 12:
        cv.put(0, 0, f"lxdtop needs at least 70x12 (this is {cv.w}x{cv.h})", "hi")
        return
    if (ui.back if ui.view == "help" else ui.view) == "detail":
        draw_status(cv, 0, mon)
        draw_detail(cv, 1, mon, ui)
    else:
        draw_main(cv, mon, ui)
    if ui.view == "help":
        draw_help(cv)


def draw_main(cv, mon, ui):
    rows = sort_rows(mon, ui.sort)
    draw_status(cv, 0, mon)
    y = 1
    running = sum(1 for row in rows if row["live"])
    top_h, mid_h, shown, fold = fit_layout(cv.w, cv.h, running, len(rows) - running)
    if top_h:
        side = cv.w * 52 // 160
        draw_cpu_panel(cv, y, 0, top_h, side, mon)
        draw_mem_panel(cv, y, side, top_h, side, mon)
        draw_net_panel(cv, y, 2 * side, top_h, cv.w - 2 * side, mon)
        y += top_h
    if mid_h:
        events_w = 54 if cv.w >= 140 else 0
        draw_graph_panel(cv, y, 0, mid_h, cv.w - events_w, mon, ui)
        if events_w:
            draw_events_panel(cv, y, cv.w - events_w, mid_h, events_w, mon)
        y += mid_h
    draw_table_panel(cv, y, 0, cv.h - y, cv.w, rows, mon, ui, shown, fold)


# --- The help screen and the detail view ------------------------------------------

def draw_help(cv):
    """Every key, from KEYS, in a box over the middle of the screen."""
    w = min(cv.w - 4, 11 + max(len(text) for _, _, text, _ in KEYS) + 3)
    h = min(cv.h - 2, len(KEYS) + 5)
    x, y = (cv.w - w) // 2, max(1, (cv.h - h) // 2)
    for row in range(y, y + h):
        cv.put(row, x, " " * w)                        # the box covers what's behind it
    box(cv, y, x, h, w, "b_events", title=[[("keys", "title")]],
        right=[[(f"lxdtop {VERSION.split()[0]}", "dim")]], footer=[[("any key", "key"), (" closes this", "text")]],
        footer_right=[[("drawing ", "dim"), (DRAWING, "text")]])      # see pick_drawing()
    for i, (label, _, text, _) in enumerate(KEYS[:h - 5]):
        cv.put(y + 2 + i, x + 3, label, "key")
        cv.put(y + 2 + i, x + 11, text, "text", x + w - 2)
    cv.put(y + h - 2, x + 3, "lxdtop only reads: no key starts, stops or changes anything", "dim", x + w - 2)


def detail_lines(row, mon, gone):
    """The detail view's lines: (label, [(text, style), ...]), from what lxdtop already has."""
    dash, kills = [("-", "dim")], mon.kills.get(row["cg"])
    live, vm = row["live"] and not gone, row["vm"]
    where = mon.server.get("member") or socket.gethostname()
    if gone:
        state = [("gone", "hi"), (": no longer on this host, last seen " + row["state"].lower(), "text")]
    else:
        state = [(row["state"].lower(), "lo" if live else "dim")]
    lines = [("state", state + [(f"   {'virtual machine' if vm else 'container'} on {where}", "dim")]),
             ("address", [(row["ip"], "ip")] if row["ip"] else dash),
             ("up", [(fmt_uptime(row["up"]), "text")] if row["up"] is not None else dash)]
    cpu = [(fmt_pct(row["cpu"]), cpu_style(row["cpu"])), (" of one core", "dim")] if row["cpu"] is not None else dash
    if row["cpu_max"] is not None:
        cpu = cpu + [("   limit ", "dim"), (f"{row['cpu_max']:.3g} cores", "text")]
    if row["throttled"] is not None and row["cpu_max"] is not None:
        cpu = cpu + [("   throttled ", "dim"), (f"{row['throttled']:.0f}%", "mid" if row["throttled"] >= THROTTLED_PCT
                                                 else "text"), (" of its periods", "dim")]
    lines.append(("cpu", cpu))
    for label, used, limit, show in (("memory", row["mem"], row["mem_max"], human),
                                     ("processes", row["tasks"], row["tasks_max"], str)):
        parts = [(show(used), "text")] if used is not None else dash
        if limit is not None:
            share = used / limit * 100 if used is not None and limit else None
            parts = parts + [("   limit ", "dim"), (show(limit) if label == "memory" else fmt_count(limit), "text")]
            parts += [(f" ({share:.0f}%)", "mid" if share >= NEAR_LIMIT_PCT else "dim")] if share is not None else []
        lines.append((label, [("inside the guest", "dim")] if vm and label == "processes" else parts))
    top = row["top"]
    lines.append(("busiest", [("inside the guest", "dim")] if vm else
                  [(top[0], "text"), (" " + fmt_pct(top[1]), cpu_style(top[1]))] if top else dash))
    past = mon.past.get(row["cg"])
    source = {"zfs": "zfs", "io": "io.stat"}.get(past[-1]["disk_src"]) if past and past[-1]["disk"] else None
    lines.append(("disk", [("read ", "dim"), (human(row["rd"]) + "/s", "text"), ("   write ", "dim"),
                           (human(row["wr"]) + "/s", "text"), (f"   from {source}" if source else "", "dim")]
                  if row["rd"] is not None else dash))
    net = [("in ", "dim"), (fmt_mbps(mbps(row["net_in"])) + " Mb/s", "text"), ("   out ", "dim"),
           (fmt_mbps(mbps(row["net_out"])) + " Mb/s", "text")] if row["net_in"] is not None else dash
    lines.append(("network", net))
    if row["waiting"]:
        resource, share = row["waiting"]
        lines.append(("waiting", [(f"{resource} {share:.0f}%", "hi" if share >= PRESSURE_PCT else "text"),
                                  (" of the last 10 s, some of its tasks stalled", "dim")]))
    else:
        lines.append(("waiting", dash))
    if kills and kills[1]:
        ago = time.monotonic() - kills[2]
        lines.append(("mem kills", [(f"{kills[1]}", "hi" if ago < RECENT_KILL else "text"),
                                    (f" since lxdtop started, the last {fmt_age(ago)} ago", "dim")]))
    else:
        lines.append(("mem kills", [("none since lxdtop started", "dim")] if kills else dash))
    taken = row["snapshot"]
    lines.append(("snapshot", [(fmt_age(time.time() - taken) + " ago", "text"),
                               (time.strftime("   %Y-%m-%d %H:%M", time.localtime(taken)), "dim")] if taken
                  else [("none", "dim")]))
    return lines


def draw_detail(cv, y, mon, ui):
    """One instance on a page of its own: everything lxdtop has for it, then its lines from the event
    feed. If it goes away, the page says so and keeps what was last seen."""
    row = next((r for r in mon.rows if r["cg"] == ui.detail), None)
    gone = row is None
    row = ui.last if gone else row
    ui.last = row
    h, w = cv.h - y, cv.w
    box(cv, y, 0, h, w, "b_table", title=[[(row["name"], "title")]],
        footer=[[("Esc", "key"), (" back", "text")], [("q", "key"), (" back", "text")],
                [("?", "key"), (" keys", "text")]],
        footer_right=[[("lxd api ", "dim"), (mon.api_status, "lo" if mon.api_status == "ok" else "mid")]])
    ix, right, line, last = 2, w - 2, y + 1, y + h - 2      # last: the lowest row inside the box
    lines = detail_lines(row, mon, gone)
    # The page takes its lines, the cpu history, a gap and the events. In a window too short for all
    # of that it's cut to fit inside the box, and its last row says how tall a window shows the rest.
    needed, room = len(lines) + 3, last - line + 1
    page = cv if needed <= room else Clipped(cv, last - 1)
    if needed > room:
        cv.put(last, ix, f"{G['more']} the rest needs a window {cv.h + needed - room} rows tall", "dim", right)
    for label, parts in lines:
        page.put(line, ix, label, "bright")
        put_parts(page, line, ix + 12, parts, right)
        line += 1
    history = list(mon.cpu_history.get(row["cg"], ()))[-(right - ix - 12):]
    page.put(line, ix, "cpu history", "bright")
    if FINE:                                       # two samples a cell, from the left like the rest
        history = list(mon.cpu_history.get(row["cg"], ()))[-2 * (right - ix - 12):]
        history = [None] * (len(history) % 2) + history
        put_cells(page, line, ix + 12, [braille_spark(*history[i:i + 2]) for i in range(0, len(history), 2)], right)
    else:
        put_cells(page, line, ix + 12, [spark(value) for value in history], right)
    line += 2
    feed, _ = mon.events.snapshot() if mon.events else ([], "off")
    mine = [event for event in feed if event["name"] == row["name"]]
    page.put(line, ix, "events", "bright")
    if not mine:
        put_parts(page, line, ix + 12, [("none since lxdtop started" if mon.events else "no event feed", "dim")],
                  right)
    for event in mine[:max(0, last + 1 - line)]:            # as many as there are rows left in the box
        label, style = EVENT_LABELS.get(event["action"], (event["action"].replace("instance-", ""), "text"))
        tail = " ".join(part for part in (event["detail"], event["user"]) if part)
        count = f"  {G['times']}{event['count']}" if event["count"] > 1 else ""
        put_parts(page, line, ix + 12, [(time.strftime("%H:%M:%S", time.localtime(event["t"])), "text"),
                                        ("  " + label[:9].ljust(10), style), (tail, "dim"), (count, "key")], right)
        line += 1


# --- One reading as JSON (--dump --json) ----------------------------------------
#
# The same readings the screen draws, as data for scripts: numbers stay numbers, in base units
# (bytes, seconds, bits per second for networks, % for CPU as the screen means it), and a value
# lxdtop has no reading for is None (null), never 0. The README has a table of the fields.

WARNING_KINDS = {5: "pool", 4: "memory_kill", 3: "pool", 2: "pressure", 1: "throttled"}   # see warnings()


def iso_utc(when):
    """Seconds since 1970 as an ISO 8601 time in UTC, e.g. 2026-11-05T14:03:07Z."""
    if when is None:
        return None
    return datetime.datetime.fromtimestamp(when, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def rounded(value, places):
    return None if value is None else round(value, places)


def bits_per_s(bytes_per_sec):
    """A network rate in bits per second (as network gear counts), from bytes per second."""
    return None if bytes_per_sec is None else round(bytes_per_sec * 8, 1)


def share_of(used, limit):
    """used as a % of limit, the way the MEM/LIMIT and PROCS/LIMIT columns work it out."""
    if used is None or limit is None:
        return None
    return round(used / limit * 100, 2) if limit else 100.0


def number(text):
    try:
        return float(text)
    except (TypeError, ValueError):
        return None


def instance_json(row, mon, now, wall):
    """One instance with every field the table can show; None where there's no reading.

    VMs and stopped instances have no container cgroup here, so no limits, throttling, pressure
    or memory kills; a VM's processes are inside its guest, so no busiest process either.
    """
    past, kills, waiting = mon.past.get(row["cg"]), mon.kills.get(row["cg"]), row["waiting"]
    top, taken = (None if row["vm"] else row["top"]), row["snapshot"]
    return {
        "name": row["name"],
        "type": "virtual-machine" if row["vm"] else "container",
        "state": row["state"],
        "ipv4": row["ip"] or None,
        "uptime_s": rounded(row["up"], 1),
        "cpu_pct": rounded(row["cpu"], 2),                        # 100 = one core
        "cpu_history_pct": [rounded(value, 2) for value in mon.cpu_history.get(row["cg"], ())],
        "busiest_process": dict(name=top[0], cpu_pct=round(top[1], 2)) if top else None,
        "mem_bytes": row["mem"],
        "disk_read_bytes_per_s": rounded(row["rd"], 1),
        "disk_write_bytes_per_s": rounded(row["wr"], 1),
        "disk_source": {"zfs": "zfs", "io": "io.stat"}.get(past[-1]["disk_src"]) if past and past[-1]["disk"] else None,
        "net_in_bits_per_s": bits_per_s(row["net_in"]),
        "net_out_bits_per_s": bits_per_s(row["net_out"]),
        "tasks": row["tasks"],
        "tasks_limit": row["tasks_max"],
        "tasks_of_limit_pct": share_of(row["tasks"], row["tasks_max"]),
        "cpu_limit_cores": rounded(row["cpu_max"], 3),
        "cpu_throttled_pct": rounded(row["throttled"], 2),
        "mem_limit_bytes": row["mem_max"],
        "mem_of_limit_pct": share_of(row["mem"], row["mem_max"]),
        "waiting_on": waiting[0] if waiting else None,
        "waiting_pct": round(waiting[1], 2) if waiting else None,
        "mem_kills": kills[1] if kills else None,                 # seen since lxdtop started
        "mem_kills_total": kills[0] if kills else None,           # the kernel's count since the instance started
        "last_mem_kill_ago_s": round(now - kills[2], 1) if kills and kills[2] is not None else None,
        "newest_snapshot_at": iso_utc(taken),
        "newest_snapshot_age_s": round(wall - taken, 1) if taken else None,
    }


def reading_json(mon, interval):
    """Everything the screen shows, as one JSON-ready dict (schema 1)."""
    now, wall, host, server = time.monotonic(), time.time(), mon.host, mon.server
    rows = sort_rows(mon, "cpu")                                  # in the table's order: busiest first
    names = {row["cg"]: row["name"] for row in rows}
    feed, events_status = mon.events.snapshot() if mon.events else ([], "off")
    read_mem = bool(host.get("mem_total"))                        # /proc/meminfo could be read
    load = [number(value) for value in host.get("load", [])] + [None] * 3
    ins, outs = list(mon.net_in), list(mon.net_out)
    zpools = host.get("zpools", {})
    pools = [dict(name=name, used_bytes=used, total_bytes=total, health=zpools.get(name))
             for name, used, total in mon.pools]
    pools += [dict(name=name, used_bytes=None, total_bytes=None, health=state)    # ZFS pools LXD didn't list
              for name, state in sorted(zpools.items()) if name not in {pool["name"] for pool in pools}]
    running = sum(1 for row in rows if row["live"])
    return {
        "schema": 1,
        "lxdtop_version": VERSION,
        "taken_at": iso_utc(wall),
        "interval_s": interval,
        "lxd_api": mon.api_status,
        "host": {
            "name": socket.gethostname(),
            "lxd_version": server.get("version") or None,
            "os": server.get("os") or None,
            "kernel": server.get("kernel") or None,
            "cluster_member": server.get("member") or None,
            "uptime_s": rounded(host.get("uptime") or None, 1),
            "cpu": {
                "busy_pct": rounded(host.get("cpu"), 2),          # the whole host: 100 = every thread busy
                "threads_busy_pct": [round(value, 2) for value in host.get("threads", [])],
                "outside_instances_pct": rounded(mon.stack[-1].get(HOST) if mon.stack else None, 2),   # 100 = one core
                "temp_c": rounded(host.get("temp"), 1),
                "clock_mhz": rounded(host.get("mhz"), 1),
                "load_1m": load[0], "load_5m": load[1], "load_15m": load[2],
            },
            "memory": {
                "total_bytes": host.get("mem_total") if read_mem else None,
                "used_bytes": host.get("mem_used") if read_mem else None,       # without the ZFS ARC
                "zfs_arc_bytes": host.get("arc") if os.path.exists(ZFS_ARCSTATS) else None,
                "available_bytes": host.get("mem_free") if read_mem else None,
                "swap_total_bytes": host.get("swap_total") if read_mem else None,
                "swap_used_bytes": host.get("swap_used") if read_mem else None,
            },
            "root_fs": dict(used_bytes=host["root_used"], total_bytes=host["root_total"])
            if host.get("root_total") else None,
        },
        "network": {
            "in_bits_per_s": bits_per_s(sum(ins[-3:]) / len(ins[-3:]) if ins else None),   # as the panel: the
            "out_bits_per_s": bits_per_s(sum(outs[-3:]) / len(outs[-3:]) if outs else None),   # last 3 readings
            "peak_bits_per_s": bits_per_s(max(ins + outs, default=None)),
            "ports": [dict(name=nic, in_bits_per_s=bits_per_s(r_in), out_bits_per_s=bits_per_s(r_out))
                      for nic, (r_in, r_out) in sorted(mon.nic_rates.items())],
        },
        "pools": pools,
        "warnings": [dict(severity=serious, kind=WARNING_KINDS[serious], instance=names.get(cg, cg) if cg else None,
                          pool=None if cg else text.split()[0], text=text)
                     for serious, _, text, cg in warnings(mon)],
        "events": {
            "status": events_status,
            "feed": [dict(time=iso_utc(event["t"]), action=event["action"], instance=event["name"] or None,
                          detail=event["detail"] or None, user=event["user"] or None, count=event["count"])
                     for event in feed],
        },
        "instance_counts": {"running": running, "stopped": len(rows) - running},
        "instances": [instance_json(row, mon, now, wall) for row in rows],
    }


# --- Running it ---------------------------------------------------------------

def curses_attrs():
    """Turn STYLES into curses attributes (a color pair, plus bold where asked)."""
    has_color = curses.has_colors()
    background = curses.COLOR_BLACK
    if has_color:
        curses.start_color()
        try:
            curses.use_default_colors()
            background = -1
        except curses.error:
            pass
    rich = has_color and curses.COLORS >= 256
    pairs, attrs = {}, {}
    for name, (color, bold) in STYLES.items():
        number = COLORS.index(color)
        if rich and name in STYLES_256:
            number, bold = STYLES_256[name]
        attr = (curses.A_BOLD if bold else curses.A_NORMAL) | (curses.A_REVERSE if name in REVERSE else 0)
        if has_color:
            if number not in pairs:
                pairs[number] = len(pairs) + 1
                curses.init_pair(pairs[number], number, background)
            attr |= curses.color_pair(pairs[number])
        attrs[name] = attr
    return attrs


def pick_drawing(asked, colors):
    """Choose the drawing, and say on the help screen which it is and why.

    The classic drawing is what the Linux console can show: 16 colors, and only the characters in
    Ubuntu's console font. The fine one is for terminal windows: braille for the CPU graph and
    history, eighth blocks for meters, and ten shades of green to red on them. It needs a UTF-8
    locale, 256 colors and a font with those characters. With no --drawing (`asked`), lxdtop draws
    fine when TERM isn't the console's (linux) and the terminal has at least 256 `colors`; --dump
    has no terminal to ask (colors is None), so it draws classic unless asked. --ascii, or a locale
    that isn't UTF-8, draws plain ASCII whatever was asked.
    """
    global FINE, DRAWING
    term = os.environ.get("TERM", "")
    if G is GLYPHS_ASCII:
        utf8 = "utf" in locale.getpreferredencoding(False).lower()
        FINE, DRAWING = False, "ascii (--ascii)" if utf8 else "ascii (not a UTF-8 locale)"
    elif asked:
        FINE, DRAWING = asked == "fine", f"{asked} (--drawing {asked})"
    elif term.startswith("linux"):
        FINE, DRAWING = False, f"classic (TERM={term})"
    elif colors is None:
        FINE, DRAWING = False, "classic (--dump)"
    else:
        FINE, DRAWING = colors >= 256, f"{'fine' if colors >= 256 else 'classic'} ({colors} colors)"


# Every key lxdtop answers to: (what the help calls it, its key codes, what it does, its action).
# The help screen (?) and --help list this table, and handle_key() looks keys up in it, so what
# they say and what the keys do can't drift apart. No key changes anything on the host.
KEYS = (
    ("q", (ord("q"), ord("Q")), "quit; on the help or detail screen, go back", "quit"),
    ("?", (ord("?"),), "this help; any key closes it", "help"),
    ("s", (ord("s"), ord("S")), "sort by the next column: " + ", ".join(SORTS), "sort"),
    ("+", (ord("+"), ord("=")), "refresh less often (up to every 10 s)", "slower"),
    ("-", (ord("-"), ord("_")), "refresh more often (down to every second)", "faster"),
    ("/", (ord("/"),), "filter by name; Enter keeps the filter, Esc clears it", "filter"),
    ("Esc", (27,), "clear the filter, then the highlight; on details, go back", "escape"),
    ("Up", (curses.KEY_UP,), "highlight the instance above", "up"),
    ("Down", (curses.KEY_DOWN,), "highlight the instance below", "down"),
    ("Enter", (10, 13, curses.KEY_ENTER), "details of the highlighted instance", "open"),
)
KEY_ACTIONS = {code: action for _, codes, _, action in KEYS for code in codes}
BACKSPACE = (curses.KEY_BACKSPACE, 127, 8)      # while typing a filter
ESC_DELAY_MS = 25                  # how long curses waits after Esc for more of a key's code (default 1000)
QUIT = "quit"


def keys_help(indent="  "):
    """The key table as lines of text, for --help."""
    return "\n".join(f"{indent}{label:<7}{text}" for label, _, text, _ in KEYS)


def new_ui(interval):
    """What the screen shows: the sort and refresh interval, which view ("main", "help", "typing" a
    filter, or "detail"), the name filter, the highlighted instance (by cgroup name), and where the
    table is scrolled to."""
    return types.SimpleNamespace(interval=interval, sort="cpu", view="main", back="main", filter="",
                                 selected=None, scroll=0, detail=None, last=None)


def name_matches(row, text):
    return text.casefold() in row["name"].casefold()


def listed_rows(mon, ui):
    """The table's rows in its order, those the filter leaves."""
    return [row for row in sort_rows(mon, ui.sort) if name_matches(row, ui.filter)]


def type_filter(key, ui):
    """A key while the filter line is open: text, Backspace, Enter (keep it) or Esc (clear it)."""
    action = KEY_ACTIONS.get(key)
    if action == "open":
        ui.view = "main"
    elif action == "escape":
        ui.view, ui.filter = "main", ""
    elif key in BACKSPACE:
        ui.filter = ui.filter[:-1]
    elif 32 <= key < 127 and len(ui.filter) < 40:
        ui.filter += chr(key)
    else:
        return False
    return True


def handle_key(key, mon, ui):
    """Act on one key press: QUIT to end lxdtop, True when the screen needs drawing again, False
    when the key does nothing here."""
    if key == -1:
        return False
    if key == curses.KEY_RESIZE:
        return True
    if ui.view == "help":                            # any key closes the help
        ui.view = ui.back
        return True
    if ui.view == "typing":
        return type_filter(key, ui)
    action = KEY_ACTIONS.get(key)
    if action == "help":
        ui.view, ui.back = "help", ui.view
    elif action == "slower":
        ui.interval = next((i for i in INTERVALS if i > ui.interval), INTERVALS[-1])
    elif action == "faster":
        ui.interval = next((i for i in reversed(INTERVALS) if i < ui.interval), INTERVALS[0])
    elif ui.view == "detail":
        if action not in ("quit", "escape"):
            return False                             # the rest are for the table
        ui.view = "main"
    elif action == "quit":
        return QUIT
    elif action == "sort":
        ui.sort = SORTS[(SORTS.index(ui.sort) + 1) % len(SORTS)]
    elif action == "filter":
        ui.view = "typing"
    elif action == "escape":
        if not (ui.filter or ui.selected):
            return False
        ui.filter, ui.selected = ("", ui.selected) if ui.filter else ("", None)
    elif action in ("up", "down"):
        rows = [row["cg"] for row in listed_rows(mon, ui)]
        if not rows:
            return False
        if ui.selected in rows:                      # one step, stopping at either end
            at = min(max(rows.index(ui.selected) + (1 if action == "down" else -1), 0), len(rows) - 1)
        else:                                        # nothing highlighted yet: start at the top or bottom
            at = 0 if action == "down" else len(rows) - 1
        ui.selected = rows[at]
    elif action == "open":
        row = next((row for row in listed_rows(mon, ui) if row["cg"] == ui.selected), None)
        if row is None:
            return False
        ui.view, ui.detail, ui.last = "detail", row["cg"], row
    else:
        return False
    return True


def run(screen, mon, ui, max_frames=0, drawing=None):
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    try:
        curses.set_escdelay(ESC_DELAY_MS)  # so Esc acts at once
    except curses.error:
        pass
    screen.timeout(250)               # check the keyboard four times a second
    attrs = curses_attrs()
    pick_drawing(drawing, getattr(curses, "COLORS", 0))     # curses sets COLORS when color starts
    mon.sample()
    next_sample = time.monotonic() + 0.5   # a quick second reading so rates show at once
    last_draw, frames = 0.0, 0
    while True:
        now = time.monotonic()
        redraw = now - last_draw >= 1     # at least once a second, for the clock and the event feed
        if now >= next_sample:
            mon.sample()
            next_sample = now + ui.interval
            redraw = True
        if redraw:
            screen.erase()
            draw(CursesCanvas(screen, attrs), mon, ui)
            screen.refresh()
            last_draw, frames = now, frames + 1
            if max_frames and frames >= max_frames:
                return
        action = handle_key(screen.getch(), mon, ui)
        if action == QUIT:
            return
        if action:
            last_draw = 0.0               # a key did something, or the screen resized: redraw now


def main():
    parser = argparse.ArgumentParser(
        description="Live, btop-style view of an LXD host, one row per container or VM. Read-only.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=f"""keys (? shows them in lxdtop too):
{keys_help()}

notes:
  CPU is shown as a share of one core: 100% = one core flat out.
  MEM for a container is its working set (memory.current minus inactive file cache);
  for a VM it is the resident memory of its QEMU process.
  DISK figures are reads and writes by the instance (ZFS counts cache hits too).
  {f"The clock shows {TIMEZONE} time unless TZ is set" if TIMEZONE else "The clock follows the system time zone"}; e.g. TZ=UTC lxdtop.
  Names, IPs, VMs, stopped instances and the event feed need access to LXD's socket
  (membership in the lxd group, or root). Exec command lines in the event feed are
  hidden unless --show-commands is given, because they can contain passwords.

needs Linux with cgroup v2 (Ubuntu 22.04 or later), LXD 5 or 6, and Python 3.""")
    parser.add_argument("-i", "--interval", type=float, default=2, help="seconds between readings (default 2)")
    parser.add_argument("--show-commands", action="store_true",
                        help="show the command line of `lxc exec` sessions in the event feed")
    parser.add_argument("--no-api", action="store_true",
                        help="skip LXD's API (no IPs, network columns, VMs, stopped instances or events)")
    parser.add_argument("--socket", help="LXD socket path (default: $LXD_DIR, then the snap's, then /var/lib/lxd)")
    parser.add_argument("--ascii", action="store_true", help="draw with plain ASCII characters")
    parser.add_argument("--drawing", choices=("fine", "classic"),
                        help="fine: braille graphs and smooth meters, for terminal windows with 256 colors; "
                             "classic: as on the Linux console. Default: fine where the terminal can show it "
                             "(--dump: classic)")
    parser.add_argument("--version", action="version", version=f"lxdtop {VERSION}")
    parser.add_argument("--dump", action="store_true", help="print one frame as text and exit")
    parser.add_argument("--json", action="store_true",
                        help="with --dump: print the reading as one JSON document instead (fields: see the README)")
    parser.add_argument("--color", action="store_true", help="with --dump: keep the colors (ANSI codes)")
    parser.add_argument("--size", default="160x45", help="with --dump: COLSxROWS (default 160x45)")
    parser.add_argument("--samples", type=int, default=2, help="with --dump: readings to take first (default 2)")
    parser.add_argument("--frames", type=int, default=0, help=argparse.SUPPRESS)   # testing: stop after N frames
    args = parser.parse_args()
    if args.json and not args.dump:
        parser.error("--json works only with --dump")

    global G
    if TIMEZONE:
        os.environ.setdefault("TZ", TIMEZONE)
    time.tzset()
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass                               # a locale this host lacks, often LANG passed on by ssh
    if args.ascii or "utf" not in locale.getpreferredencoding(False).lower():
        G = GLYPHS_ASCII

    api = events = None
    socket_path = args.socket or next((p for p in LXD_SOCKETS if os.path.exists(p)), None)
    if not args.no_api and socket_path:
        api = LxdApi(socket_path)
        api.fetch()                        # first answer up front, so names show at once
        api.start()
        events = LxdEvents(socket_path, show_commands=args.show_commands)
        events.start()
    mon = Monitor(api, events)
    ui = new_ui(args.interval)

    if args.dump:
        cols, rows = (int(n) for n in args.size.lower().split("x"))
        for i in range(max(2, args.samples)):
            if i:
                time.sleep(args.interval)
            mon.sample()
        if args.json:
            print(json.dumps(reading_json(mon, args.interval), indent=2))   # ensure_ascii: no raw control bytes
            return
        pick_drawing(args.drawing, None)
        canvas = TextCanvas(rows, cols)
        draw(canvas, mon, ui)
        print(canvas.text(color=args.color))
        return
    try:
        curses.wrapper(run, mon, ui, args.frames, args.drawing)
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
